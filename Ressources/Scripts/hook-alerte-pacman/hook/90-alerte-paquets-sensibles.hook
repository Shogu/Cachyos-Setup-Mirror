# Alerte visible quand une mise à jour touche tuned ou un noyau CachyOS / LTS.
# Ne bloque rien : affiche seulement un gros avertissement avant l'installation.
[Trigger]
Operation = Upgrade
Type = Package
Target = tuned
Target = tuned-*
Target = linux-cachyos*
Target = linux-lts*

[Action]
Description = Vérification des paquets sensibles (tuned, noyaux)...
When = PreTransaction
Exec = /usr/local/bin/alerte-paquets-sensibles
NeedsTargets
