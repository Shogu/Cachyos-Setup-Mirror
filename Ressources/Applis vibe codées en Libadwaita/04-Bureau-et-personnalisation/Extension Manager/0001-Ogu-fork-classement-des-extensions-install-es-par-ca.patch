+static gboolean
+category_filter_func (gpointer            item,
+                      CategoryFilterData *data)
+{
+    ExmInstalledPage *self = data->page;
+    gboolean is_user = FALSE;
+
+    if (!EXM_IS_EXTENSION (item))
+        return FALSE;
+
+    g_object_get (item, "is-user", &is_user, NULL);
+    if (!is_user)
+        return FALSE;
+
+    return g_strcmp0 (exm_categories_resolve (EXM_EXTENSION (item), self->category_overrides),
+                      exm_categories_get_id (data->index)) == 0;
+}
+
+static void
+on_categories_changed (GSettings        *settings,
+                       const char       *key G_GNUC_UNUSED,
+                       ExmInstalledPage *self)
+{
+    g_clear_pointer (&self->category_overrides, g_hash_table_unref);
+    self->category_overrides = exm_categories_load_overrides (settings);
+
+    for (guint i = 0; i < self->category_filters->len; i++)
+        gtk_filter_changed (g_ptr_array_index (self->category_filters, i),
+                            GTK_FILTER_CHANGE_DIFFERENT);
+}
+
+static void
+setup_categories (ExmInstalledPage *self)
+{
+    guint n = exm_categories_get_n ();
+
+    self->category_groups = g_ptr_array_new ();
+    self->category_filters = g_ptr_array_new_with_free_func (g_object_unref);
+    self->category_overrides = exm_categories_load_overrides (self->settings);
+
+    // Keep "System Extensions" last: take it out and put it back after the categories
+    g_object_ref (self->system_prefs_group);
+    adw_preferences_page_remove (self->list_page, self->system_prefs_group);
+
+    for (guint i = 0; i < n; i++)
+    {
+        AdwPreferencesGroup *group;
+        CategoryFilterData *data;
+        GtkCustomFilter *filter;
+        g_autofree char *title = g_markup_escape_text (exm_categories_get_title (i), -1);
+
+        group = ADW_PREFERENCES_GROUP (adw_preferences_group_new ());
+        adw_preferences_group_set_title (group, title);
+        gtk_widget_set_visible (GTK_WIDGET (group), FALSE);
+        adw_preferences_page_add (self->list_page, group);
+        g_ptr_array_add (self->category_groups, group);
+
+        data = g_new0 (CategoryFilterData, 1);
+        data->page = self;
+        data->index = i;
+        filter = gtk_custom_filter_new ((GtkCustomFilterFunc) category_filter_func, data, g_free);
+        g_ptr_array_add (self->category_filters, filter);
+    }
+
+    adw_preferences_page_add (self->list_page, self->system_prefs_group);
+    g_object_unref (self->system_prefs_group);
+
+    g_signal_connect_object (self->settings, "changed::" EXM_CATEGORIES_KEY,
+                             G_CALLBACK (on_categories_changed), self, 0);
+}
