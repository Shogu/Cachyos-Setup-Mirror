     exm_extension_bind_toggle (self->extension, self->ext_toggle);
+
+    update_category_button (self);
+}
+
+static void
+update_category_button (ExmExtensionRow *self)
+{
+    GAction *action;
+
+    if (self->category_btn == NULL)
+        return;
+
+    // Categories only apply to user-installed extensions
+    gtk_widget_set_visible (GTK_WIDGET (self->category_btn),
+                            row_is_selectable (self) && !self->selection_mode);
+
+    if (self->settings == NULL || self->uuid == NULL)
+        return;
+
+    action = g_action_map_lookup_action (G_ACTION_MAP (self->action_group), "category");
+    g_simple_action_set_state (G_SIMPLE_ACTION (action),
+                               g_variant_new_string (exm_categories_get_override (self->settings,
+                                                                                  self->uuid)));
+}
+
+static void
+on_categories_changed (GSettings       *settings G_GNUC_UNUSED,
+                       const char      *key G_GNUC_UNUSED,
+                       ExmExtensionRow *self)
+{
+    update_category_button (self);
+}
+
+static void
+change_category (GSimpleAction   *action G_GNUC_UNUSED,
+                 GVariant        *value,
+                 ExmExtensionRow *self)
+{
+    const char *id;
+
+    if (self->settings == NULL || self->uuid == NULL)
+        return;
+
+    id = g_variant_get_string (value, NULL);
+
+    // "auto" removes the stored choice
+    exm_categories_set_override (self->settings, self->uuid,
+                                 g_strcmp0 (id, EXM_CATEGORY_AUTO) == 0 ? NULL : id);
+}
+
+static GMenuModel *
+build_category_menu (void)
+{
+    GMenu *menu = g_menu_new ();
+    GMenu *section = g_menu_new ();
+
+    for (guint i = 0; i < exm_categories_get_n (); i++)
+    {
+        g_autoptr (GMenuItem) item = g_menu_item_new (exm_categories_get_title (i), NULL);
+
+        g_menu_item_set_action_and_target (item, "row.category", "s",
+                                           exm_categories_get_id (i));
+        g_menu_append_item (section, item);
+    }
+
+    g_menu_append_section (menu, NULL, G_MENU_MODEL (section));
+    g_object_unref (section);
+
+    section = g_menu_new ();
+    {
+        g_autoptr (GMenuItem) item = g_menu_item_new (_("Automatic Category"), NULL);
+
+        g_menu_item_set_action_and_target (item, "row.category", "s", EXM_CATEGORY_AUTO);
+        g_menu_append_item (section, item);
+    }
+    g_menu_append_section (menu, NULL, G_MENU_MODEL (section));
+    g_object_unref (section);
+
+    return G_MENU_MODEL (menu);
 }
 
 static gboolean
