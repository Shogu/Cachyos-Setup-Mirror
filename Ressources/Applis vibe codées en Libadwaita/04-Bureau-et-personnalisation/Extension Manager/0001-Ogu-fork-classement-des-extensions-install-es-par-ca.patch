@@ -387,6 +479,23 @@ exm_extension_row_init (ExmExtensionRow *self)
     g_action_map_add_action (G_ACTION_MAP (self->action_group), G_ACTION (open_prefs_action));
     g_action_map_add_action (G_ACTION_MAP (self->action_group), G_ACTION (show_error_action));
 
+    category_action = g_simple_action_new_stateful ("category", G_VARIANT_TYPE_STRING,
+                                                     g_variant_new_string (EXM_CATEGORY_AUTO));
+    g_signal_connect (category_action, "change-state", G_CALLBACK (change_category), self);
+    g_action_map_add_action (G_ACTION_MAP (self->action_group), G_ACTION (category_action));
+
+    g_object_unref (open_prefs_action);
