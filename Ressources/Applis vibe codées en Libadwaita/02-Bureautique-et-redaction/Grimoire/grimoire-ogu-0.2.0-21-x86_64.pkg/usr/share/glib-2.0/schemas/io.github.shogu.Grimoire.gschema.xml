<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="io.github.shogu.Grimoire.ColorScheme">
    <value nick="system" value="0"/>
    <value nick="light" value="1"/>
    <value nick="dark" value="2"/>
  </enum>
  <schema id="io.github.shogu.Grimoire" path="/io/github/shogu/Grimoire/">
    <key name="color-scheme" enum="io.github.shogu.Grimoire.ColorScheme">
      <default>'system'</default>
      <summary>Colour scheme</summary>
      <description>Follow the system preference, or force the light or dark style.</description>
    </key>
    <key name="pinned-folder" type="s">
      <default>''</default>
      <summary>Active pinned folder</summary>
      <description>Absolute path of the pinned folder currently listed in the Documents section.</description>
    </key>
    <key name="pinned-folders" type="as">
      <default>[]</default>
      <summary>Pinned folders</summary>
      <description>Absolute paths of the folders offered in the Documents switcher, in pinning order.</description>
    </key>
    <key name="documents-expanded" type="b">
      <default>true</default>
      <summary>Documents section expanded</summary>
    </key>
    <key name="outline-expanded" type="b">
      <default>true</default>
      <summary>Outline section expanded</summary>
    </key>
    <key name="text-zoom" type="i">
      <range min="70" max="200"/>
      <default>100</default>
      <summary>Text size</summary>
      <description>Display zoom of the source view and of the preview, in percent.</description>
    </key>
    <key name="use-system-font" type="b">
      <default>true</default>
      <summary>Use the system monospace font</summary>
      <description>Follow the GNOME monospace font for the editor instead of the custom font.</description>
    </key>
    <key name="editor-font" type="s">
      <default>'Adwaita Sans 12'</default>
      <summary>Editor font</summary>
      <description>Font family and size used by the editor when the system font is not used.</description>
    </key>
    <key name="show-line-numbers" type="b">
      <default>true</default>
      <summary>Show line numbers</summary>
    </key>
    <key name="highlight-current-line" type="b">
      <default>true</default>
      <summary>Highlight the current line</summary>
    </key>
    <key name="show-grid" type="b">
      <default>false</default>
      <summary>Draw a background grid</summary>
    </key>
    <key name="legacy-imported" type="b">
      <default>false</default>
      <summary>Legacy preferences.json already imported</summary>
    </key>
  </schema>
</schemalist>
