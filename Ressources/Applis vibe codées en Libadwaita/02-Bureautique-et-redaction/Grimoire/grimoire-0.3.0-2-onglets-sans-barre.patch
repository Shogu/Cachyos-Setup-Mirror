+    def scroll_tabs(self, controller, _dx, dy):
+        if controller.get_current_event_device() and \
+                controller.get_current_event_device().get_source() == Gdk.InputSource.TOUCHPAD:
+            return False  # le pavé tactile défile déjà à l'horizontale
+        adjustment = self.tabs_scroll.get_hadjustment()
+        adjustment.set_value(adjustment.get_value() + dy * 60)
+        return True
+
+    def reveal_active_tab(self):
+        """Bring the active tab into view once the tab bar has been laid out."""
+        child = self.tabs.get_first_child()
+        while child:
+            for tab in (child, *self.children_of(child)):
+                if isinstance(tab, Gtk.ToggleButton) and tab.get_active():
+                    ok, bounds = tab.compute_bounds(self.tabs)
+                    if ok:
+                        adjustment = self.tabs_scroll.get_hadjustment()
+                        x, width = bounds.get_x(), bounds.get_width()
+                        if x < adjustment.get_value():
+                            adjustment.set_value(x)
+                        elif x + width > adjustment.get_value() + adjustment.get_page_size():
+                            adjustment.set_value(x + width - adjustment.get_page_size())
+                    return GLib.SOURCE_REMOVE
+            child = child.get_next_sibling()
+        return GLib.SOURCE_REMOVE
+
+    @staticmethod
+    def children_of(widget):
+        child = widget.get_first_child()
+        while child:
+            yield child
+            child = child.get_next_sibling()
