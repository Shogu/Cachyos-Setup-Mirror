# Maintainer: Shogu
pkgname=maquette
pkgver=1.1.1
pkgrel=1
pkgdesc="Assembler et préparer des documents PDF (GTK4/libadwaita)"
arch=('any')
url="https://gitlab.com/shogu/maquette"
license=('AGPL-3.0-or-later')
depends=('python' 'python-gobject' 'python-cairo' 'gtk4' 'libadwaita'
         'python-pymupdf' 'python-pillow' 'hicolor-icon-theme')

package() {
  cd "$startdir"
  install -d "$pkgdir/usr/lib/maquette/maquette"
  install -m644 src/maquette/*.py src/maquette/style.css "$pkgdir/usr/lib/maquette/maquette/"
  install -Dm755 data/maquette.sh "$pkgdir/usr/bin/maquette"
  install -Dm644 data/io.gitlab.shogu.Maquette.desktop \
    "$pkgdir/usr/share/applications/io.gitlab.shogu.Maquette.desktop"
  install -Dm644 data/io.gitlab.shogu.Maquette.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.gitlab.shogu.Maquette.metainfo.xml"
  install -Dm644 data/io.gitlab.shogu.Maquette.gschema.xml \
    "$pkgdir/usr/share/glib-2.0/schemas/io.gitlab.shogu.Maquette.gschema.xml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/maquette/README.md"
  for d in scalable/apps symbolic/apps 128x128/apps scalable/actions; do
    install -d "$pkgdir/usr/share/icons/hicolor/$d"
    install -m644 "data/icons/hicolor/$d/"* "$pkgdir/usr/share/icons/hicolor/$d/"
  done
}
