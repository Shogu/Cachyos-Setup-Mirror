[Desktop Entry]
Type=Application
Name=Maquette
GenericName=Assemblage de PDF
Comment=Assembler et préparer des documents PDF : fusionner, réordonner, recadrer, composer des livrets
Exec=maquette %F
Icon=io.gitlab.shogu.Maquette
Terminal=false
Categories=Office;Publishing;GTK;
Keywords=PDF;fusionner;assembler;livret;brochure;recadrer;pages;
MimeType=application/pdf;image/png;image/jpeg;image/webp;image/tiff;image/gif;
StartupNotify=true
