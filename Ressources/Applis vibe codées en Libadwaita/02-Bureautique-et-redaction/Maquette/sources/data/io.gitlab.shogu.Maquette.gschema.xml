<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="maquette">
  <enum id="io.gitlab.shogu.Maquette.Dossier">
    <value nick="source" value="0"/>
    <value nick="dernier" value="1"/>
    <value nick="fixe" value="2"/>
  </enum>
  <enum id="io.gitlab.shogu.Maquette.FormatBlanc">
    <value nick="voisine" value="0"/>
    <value nick="a4-portrait" value="1"/>
    <value nick="a4-paysage" value="2"/>
    <value nick="a3-portrait" value="3"/>
    <value nick="a3-paysage" value="4"/>
  </enum>
  <enum id="io.gitlab.shogu.Maquette.Imposition">
    <value nick="fidele" value="0"/>
    <value nick="brochure-a5" value="1"/>
    <value nick="livret-a4" value="2"/>
  </enum>
  <enum id="io.gitlab.shogu.Maquette.ModeImage">
    <value nick="ajustee" value="0"/>
    <value nick="pleine" value="1"/>
  </enum>

  <schema id="io.gitlab.shogu.Maquette" path="/io/gitlab/shogu/Maquette/">
    <key name="dossier-propose" enum="io.gitlab.shogu.Maquette.Dossier">
      <default>'source'</default>
      <summary>Dossier proposé à l'enregistrement</summary>
    </key>
    <key name="dossier-fixe" type="s">
      <default>''</default>
      <summary>Dossier d'enregistrement choisi une fois pour toutes</summary>
    </key>
    <key name="dernier-dossier" type="s">
      <default>''</default>
      <summary>Dernier dossier utilisé</summary>
    </key>
    <key name="suffixe-nom" type="s">
      <default>'-maquette'</default>
      <summary>Suffixe ajouté au nom proposé</summary>
    </key>
    <key name="ouvrir-apres" type="b">
      <default>false</default>
      <summary>Ouvrir le fichier après l'enregistrement</summary>
    </key>
    <key name="confirmer-fermeture" type="b">
      <default>true</default>
      <summary>Demander avant de fermer un document modifié</summary>
    </key>

    <key name="taille-miniatures" type="i">
      <range min="96" max="400"/>
      <default>150</default>
      <summary>Largeur des miniatures (pixels)</summary>
    </key>
    <key name="numeros" type="b">
      <default>true</default>
      <summary>Numéros de page sous les miniatures</summary>
    </key>
    <key name="couleur-source" type="b">
      <default>true</default>
      <summary>Bande de couleur indiquant le fichier d'origine</summary>
    </key>

    <key name="format-page-blanche" enum="io.gitlab.shogu.Maquette.FormatBlanc">
      <default>'voisine'</default>
      <summary>Format des pages blanches</summary>
    </key>
    <key name="images-marges" type="d">
      <range min="0" max="50"/>
      <default>10</default>
      <summary>Marges autour des images (mm)</summary>
    </key>
    <key name="images-mode" enum="io.gitlab.shogu.Maquette.ModeImage">
      <default>'ajustee'</default>
      <summary>Mise en page des images</summary>
    </key>
    <key name="images-orientation-auto" type="b">
      <default>true</default>
      <summary>Page en paysage pour les images plus larges que hautes</summary>
    </key>
    <key name="images-demander" type="b">
      <default>false</default>
      <summary>Demander la mise en page à chaque insertion d'images</summary>
    </key>
    <key name="texte-taille" type="d">
      <range min="6" max="48"/>
      <default>12</default>
      <summary>Corps du texte posé sur une page (pt)</summary>
    </key>
    <key name="texte-couleur" type="s">
      <default>'#000000'</default>
      <summary>Couleur du texte posé sur une page</summary>
    </key>

    <key name="imposition" enum="io.gitlab.shogu.Maquette.Imposition">
      <default>'fidele'</default>
      <summary>Mise en page du fichier enregistré</summary>
    </key>
    <key name="compresser" type="b">
      <default>true</default>
      <summary>Compresser et alléger le fichier enregistré</summary>
    </key>
    <key name="reduire-images" type="b">
      <default>false</default>
      <summary>Réduire la résolution des images</summary>
    </key>
    <key name="dpi-images" type="i">
      <range min="72" max="300"/>
      <default>150</default>
      <summary>Résolution maximale des images (ppp)</summary>
    </key>
    <key name="effacer-metadonnees" type="b">
      <default>false</default>
      <summary>Effacer les métadonnées</summary>
    </key>
  </schema>
</schemalist>
