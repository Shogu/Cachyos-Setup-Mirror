#  Fenêtre principale
# --------------------------------------------------------------------------

class MainWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Snapper",
                         default_width=560, default_height=700)
        self.selected = None          # (id, date, desc)
        self.rows = []
        self.runner = None
        self.running = False          # une restauration est en cours
        self.busy = False             # une autre opération (création, suppression…) est en cours
        self.booted_id = booted_snapshot_id()
        self.status_action = None
        self.row_info = []
        self.groups = []
        self.filter_mode = "all"
        self.loaded_once = False
        self.snap_meta = {}
        self.snapper_info = {}        # {id: infos Snapper}
        self.delete_page = None
        self.cleanup_page = None
        self._load_toast = False
        self._reload_id = 0
        self._log_flush_id = 0
        self._interrupted = False

        self.nav = Adw.NavigationView()
        self.toast_overlay = Adw.ToastOverlay()
        self.toast_overlay.set_child(self.nav)
        self.set_content(self.toast_overlay)
        self.nav.add(self._build_main_page())

        for name, callback in (("search", self._toggle_search),
                               ("refresh", lambda: self.load_snapshots(toast=True)),
                               ("create", self._on_create),
                               ("delete", self._open_delete),
                               ("cleanup", self._open_cleanup),
                               ("shortcuts", self._show_shortcuts),
                               ("about", self._show_about)):
            act = Gio.SimpleAction.new(name, None)
            act.connect("activate", lambda *_a, cb=callback: cb())
            self.add_action(act)
        app.set_accels_for_action("win.search", ["<Control>f"])
        app.set_accels_for_action("win.refresh", ["<Control>r", "F5"])
        app.set_accels_for_action("win.create", ["<Control>n"])

        self.connect("close-request", self._on_close_request)

    # ---- page principale -------------------------------------------------

    def _build_main_page(self):
        header = Adw.HeaderBar()
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Actualiser (Ctrl+R)")
        refresh.connect("clicked", lambda *_: self.load_snapshots(toast=True))
        header.pack_start(refresh)
        self.create_btn = Gtk.Button(icon_name="list-add-symbolic",
                                     tooltip_text="Créer un snapshot (Ctrl+N)")
        self.create_btn.connect("clicked", lambda *_: self._on_create())
        header.pack_start(self.create_btn)

        menu = Gio.Menu()
        manage = Gio.Menu()
        manage.append("Supprimer des snapshots…", "win.delete")
        manage.append("Nettoyage automatique…", "win.cleanup")
        menu.append_section(None, manage)
        about = Gio.Menu()
        about.append("Raccourcis clavier", "win.shortcuts")
        about.append("À propos de Snapper", "win.about")
        menu.append_section(None, about)
        menu_btn = Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu,
                                  tooltip_text="Menu")
        header.pack_end(menu_btn)

        self.search_toggle = Gtk.ToggleButton(icon_name="system-search-symbolic",
                                              tooltip_text="Rechercher (Ctrl+F)")
        header.pack_end(self.search_toggle)
        self.search_entry = Gtk.SearchEntry(
            hexpand=True, placeholder_text="Rechercher : description, #ID, date, « avant » ou « après »")
        self.search_bar = Gtk.SearchBar(child=self.search_entry, search_mode_enabled=False)
        # Recherche volontaire uniquement : la frappe globale n'est jamais capturée.
        self.search_bar.connect_entry(self.search_entry)
        self.search_toggle.bind_property("active", self.search_bar, "search-mode-enabled",
                                         GObject.BindingFlags.BIDIRECTIONAL)
        self.search_entry.connect("search-changed", lambda *_: self._apply_filter())
        self.search_entry.connect("stop-search", lambda *_: self.search_bar.set_search_mode(False))
        self.search_bar.connect("notify::search-mode-enabled", self._on_search_mode)

        filter_box = Gtk.Box(halign=Gtk.Align.CENTER, spacing=0,
                             margin_top=6, margin_bottom=6)
        filter_box.add_css_class("linked")
        first_filter = None
        self.filter_buttons = {}
        for mode, label in (("all", "Tous"), ("pre", "Avant"), ("post", "Après")):
            btn = Gtk.ToggleButton(label=label)
            if first_filter is None:
                first_filter = btn
                btn.set_active(True)
            else:
                btn.set_group(first_filter)
            btn.connect("toggled", self._on_quick_filter, mode)
            filter_box.append(btn)
            self.filter_buttons[mode] = btn
        self.filter_bar = Adw.Clamp(maximum_size=600, child=filter_box)

        self.banner = Adw.Banner(title="", revealed=False)
        self.type_banner = Adw.Banner(
            title="Les informations Avant / Après ne sont pas disponibles.", revealed=False)
        self.busy_banner = Adw.Banner(title="", revealed=False)

        # Chargement
        spinner = Gtk.Spinner(spinning=True, width_request=32, height_request=32,
                              halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)

        # Erreur / vide
        self.status = Adw.StatusPage(icon_name="dialog-information-symbolic")
        self.status_btn = Gtk.Button(halign=Gtk.Align.CENTER)
        self.status_btn.add_css_class("pill")
        self.status_btn.connect("clicked", lambda *_: self.status_action and self.status_action())
        self.status.set_child(self.status_btn)

        # Liste
        self.hint = Gtk.Label(label=HINT, xalign=0, wrap=True)
        self.hint.add_css_class("dim-label")
        self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24,
                      margin_top=24, margin_bottom=24, margin_start=12, margin_end=12)
        box.append(self.hint)
        box.append(self.list_box)
        clamp = Adw.Clamp(maximum_size=600, child=box)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, child=clamp)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, vexpand=True)
        self.stack.add_named(spinner, "loading")
        self.stack.add_named(self.status, "status")
        self.stack.add_named(scroller, "list")
        self.stack.set_visible_child_name("loading")

        # Barre d'action fixe : toujours visible, même avec une longue liste.
        self.selection_title = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        self.selection_title.add_css_class("heading")
        self.selection_sub = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.selection_sub.add_css_class("dim-label")
        self.selection_sub.add_css_class("caption")
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        labels.append(self.selection_title)
        labels.append(self.selection_sub)
        self.desc_entry = Gtk.Entry(
            hexpand=True, placeholder_text="Description de la sauvegarde avant restauration (facultatif)")
        self.desc_entry.connect("activate", lambda *_: self._on_restore_clicked())
        self.restore_btn = Gtk.Button(label="Restaurer", sensitive=False)
        self.restore_btn.add_css_class("suggested-action")
        self.restore_btn.connect("clicked", self._on_restore_clicked)
        action_row = Gtk.Box(spacing=8)
        action_row.append(self.desc_entry)
        action_row.append(self.restore_btn)
        bar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                      margin_top=10, margin_bottom=10, margin_start=12, margin_end=12)
        bar.append(labels)
        bar.append(action_row)

        self.main_view = Adw.ToolbarView(content=self.stack)
        self.main_view.add_top_bar(header)
        self.main_view.add_top_bar(self.search_bar)
        self.main_view.add_top_bar(self.filter_bar)
        self.main_view.add_top_bar(self.busy_banner)
        self.main_view.add_top_bar(self.banner)
        self.main_view.add_top_bar(self.type_banner)
        self.main_view.add_bottom_bar(Adw.Clamp(maximum_size=600, child=bar))
        self.main_view.set_bottom_bar_style(Adw.ToolbarStyle.RAISED)
        self.main_view.set_reveal_bottom_bars(False)
        return Adw.NavigationPage(title="Snapper", tag="main", child=self.main_view)

    # ---- opération en cours ---------------------------------------------

    def _begin_busy(self, text):
        self.busy = True
        self.busy_banner.set_title(text)
        self.busy_banner.set_revealed(True)
        self.create_btn.set_sensitive(False)
        self._update_selection_ui()

    def _end_busy(self):
        self.busy = False
        self.busy_banner.set_revealed(False)
        self.create_btn.set_sensitive(True)
        self._update_selection_ui()

    def _reload_later(self, ms=2500):
        """Limine se resynchronise en arrière-plan après une création / suppression."""
        if self._reload_id:
            GLib.source_remove(self._reload_id)
        self._reload_id = GLib.timeout_add(ms, self._do_reload)

    def _do_reload(self):
        self._reload_id = 0
        if not self.running:
            self.load_snapshots()
        return False

    # ---- chargement de la liste ----------------------------------------

    def load_snapshots(self, toast=False):
        if self.running:
            return
        self._load_toast = toast
        self.stack.set_visible_child_name("loading")
        run_helper(["list"], self._on_list_done)

    def _on_list_done(self, rc, out, err):
        list_part, _, snap_part = out.partition(TYPES_MARK)
        rows = parse_snapshots(list_part)
        info = parse_snapper_list(snap_part)
        self.snapper_info = info
        types = {i: (v["type"], v["pre"]) for i, v in info.items()}
        if self.delete_page is not None:
            self.delete_page.set_data(info)
        if rows:
            self._populate(rows, types)
            self.type_banner.set_revealed(not types)
        elif rc == 0:
            self._show_status("folder-symbolic", "Aucun snapshot amorçable",
                              "Limine ne contient encore aucun snapshot à restaurer. "
                              "Vous pouvez en créer un avec le bouton +.",
                              "Actualiser", self.load_snapshots)
        else:
            self._show_status("dialog-error-symbolic", "Lecture impossible",
                              friendly_error(rc, err, list_part), "Réessayer", self.load_snapshots)

    def _show_status(self, icon, title, desc, button=None, action=None):
        self.status.set_icon_name(icon)
        self.status.set_title(title)
        self.status.set_description(GLib.markup_escape_text(desc))
        self.status_btn.set_visible(button is not None)
        if button:
            self.status_btn.set_label(button)
        self.status_action = action
        self.stack.set_visible_child_name("status")

    def _populate(self, rows, types=None):
        now = datetime.datetime.now()
        types = types or {}
        type_filters_available = bool(types)
        self.filter_buttons["pre"].set_sensitive(type_filters_available)
        self.filter_buttons["post"].set_sensitive(type_filters_available)
        if not type_filters_available and self.filter_mode in ("pre", "post"):
            self.filter_buttons["all"].set_active(True)
            self.filter_mode = "all"
        post_of = {pre: sid for sid, (t, pre) in types.items() if t == "post" and pre}
        for g in self.groups:
            self.list_box.remove(g)
        self.groups, self.rows, self.row_info, self.selected = [], [], [], None
        self.snap_meta = {}
        self._update_selection_ui()

        first = None
        current, group = None, None
        ordered = sorted(rows, key=lambda s: (parse_date(s[1]) or datetime.datetime.min, s[0]),
                         reverse=True)
        for snap in ordered:
            sid, date, desc = snap
            dt = parse_date(date)
            label = time_bucket(dt, now)
            if label != current:
                current = label
                group = Adw.PreferencesGroup(title=label)
                self.list_box.append(group)
                self.groups.append(group)
            stype, pre_id = types.get(sid, (None, None))
            sub = f"#{sid} · {date}"
            if stype == "post" and pre_id:
                sub += f" · suite du #{pre_id}"
            elif stype == "pre" and sid in post_of:
                sub += f" · suivi du #{post_of[sid]}"
            row = Adw.ActionRow(title=GLib.markup_escape_text(desc or "(sans description)"),
                                subtitle=GLib.markup_escape_text(sub))
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if first is None:
                first = check
            else:
                check.set_group(first)
            check.connect("toggled", self._on_toggled, snap)
            row.add_prefix(check)
            row.set_activatable_widget(check)
            if sid == self.booted_id:
                tag = Gtk.Label(label="Actuel", valign=Gtk.Align.CENTER)
                tag.add_css_class("accent")
                tag.add_css_class("caption-heading")
                row.add_suffix(tag)
            badge = TYPE_BADGES.get(stype)
            self.snap_meta[sid] = (stype, badge[0] if badge else "")
            if badge:
                tl = Gtk.Label(label=badge[0], valign=Gtk.Align.CENTER)
                tl.add_css_class(badge[1])
                tl.add_css_class("caption-heading")
                row.add_suffix(tl)
            group.add(row)
            self.rows.append(row)
            self.row_info.append((row,
                                  f"{sid} {date} {desc} {badge[0] if badge else ''}".lower(),
                                  group, check, snap, stype, dt))

        if self.booted_id is not None:
            self.banner.set_title(f"Vous utilisez le snapshot #{self.booted_id}. "
                                  "Restaurez-le avant de redémarrer sur le système normal.")
            self.banner.set_revealed(True)
        else:
            self.banner.set_revealed(False)
        self._apply_filter()
        self.stack.set_visible_child_name("list")
        if self._load_toast:
            self._toast("Liste actualisée")
        self._load_toast = False
        self.loaded_once = True

    # ---- recherche ------------------------------------------------------

    def _toggle_search(self):
        if self.search_bar.get_search_mode() and self.search_entry.has_focus():
            self.search_bar.set_search_mode(False)
        else:
            self.search_bar.set_search_mode(True)
            self.search_entry.grab_focus()

    def _on_search_mode(self, *_):
        if not self.search_bar.get_search_mode():
            self.search_entry.set_text("")
            self._apply_filter()

    def _on_quick_filter(self, button, mode):
        if button.get_active():
            self.filter_mode = mode
            self._apply_filter()

    def _apply_filter(self):
        words = self.search_entry.get_text().lower().split()
        shown, visible_groups = 0, set()
        selected_visible = self.selected is None
        for row, hay, group, check, snap, stype, dt in self.row_info:
            text_ok = all(w in hay for w in words)
            if self.filter_mode == "pre":
                quick_ok = stype == "pre"
            elif self.filter_mode == "post":
                quick_ok = stype == "post"
            else:
                quick_ok = True
            vis = text_ok and quick_ok
            row.set_visible(vis)
            shown += int(vis)
            if vis:
                visible_groups.add(group)
            if self.selected is not None and snap[0] == self.selected[0] and vis:
                selected_visible = True
        for g in self.groups:
            g.set_visible(g in visible_groups)
        self.hint.set_label("Aucun snapshot ne correspond aux filtres."
                            if self.row_info and not shown else HINT)
        if not selected_visible:
            self._clear_selection()

    def _clear_selection(self):
        current = self.selected[0] if self.selected else None
        self.selected = None
        for _, _, _, check, snap, _, _ in self.row_info:
            if current is not None and snap[0] == current and check.get_active():
                check.set_active(False)
        self._update_selection_ui()

    def _on_toggled(self, check, snap):
        if check.get_active():
            self.selected = snap
            self._update_selection_ui()
        elif self.selected and snap[0] == self.selected[0]:
            self.selected = None
            self._update_selection_ui()

    def _update_selection_ui(self):
        active = self.selected is not None
        self.restore_btn.set_sensitive(active and not self.busy and not self.running)
        self.main_view.set_reveal_bottom_bars(active)
        if not active:
            return
        sid, date, desc = self.selected
        stype, badge = self.snap_meta.get(sid, (None, ""))
        self.selection_title.set_label(f"Snapshot #{sid}" + (f" · {badge}" if badge else ""))
        self.selection_sub.set_label(" · ".join(x for x in (date, desc) if x))

    # ---- création d'un snapshot ----------------------------------------

    def _on_create(self):
        if self.running or self.busy:
            return
        desc = Adw.EntryRow(title="Description")
        algo = Adw.ComboRow(
            title="Nettoyage automatique",
            subtitle="Quand Snapper peut le supprimer tout seul",
            model=Gtk.StringList.new(["Jamais (conservé jusqu'à suppression)",
                                      "Par nombre (number)",
                                      "Chronologique (timeline)"]))
        important = Adw.SwitchRow(title="Important",
                                  subtitle="Conservé plus longtemps par le nettoyage")
        lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        lst.add_css_class("boxed-list")
        for r in (desc, algo, important):
            lst.append(r)
        dialog = Adw.AlertDialog(
            heading="Créer un snapshot",
            body="Un snapshot de l'état actuel du système sera créé, puis ajouté au menu Limine.")
        dialog.set_extra_child(lst)
        dialog.add_response("cancel", "Annuler")
        dialog.add_response("create", "Créer")
        dialog.set_response_appearance("create", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_response_enabled("create", False)
        dialog.set_close_response("cancel")
        desc.connect("changed", lambda *_: dialog.set_response_enabled(
            "create", bool(desc.get_text().strip())))
        dialog.connect("response", self._on_create_response, desc, algo, important)
        dialog.present(self)

    def _on_create_response(self, dialog, response, desc, algo, important):
        if response != "create":
            return
        text = desc.get_text().strip()[:200]
        if not text:
            return
        cleanup = ("-", "number", "timeline")[algo.get_selected()]
        self._begin_busy("Création du snapshot…")
        run_helper(["create", text, cleanup, "1" if important.get_active() else "0"],
                   self._on_create_done)

    def _on_create_done(self, rc, out, err):
        self._end_busy()
        if rc == 0:
            n = out.strip().splitlines()[-1] if out.strip() else ""
            self._toast(f"Snapshot #{n} créé — Limine se met à jour" if n.isdigit()
                        else "Snapshot créé")
            self._reload_later()
        else:
            self._error_dialog("Création impossible", friendly_error(rc, err, out))

    # ---- suppression et nettoyage ---------------------------------------

    def _open_delete(self):
        if self.running or self.busy:
            return
        if not self.snapper_info:
            self._toast("La liste Snapper n'est pas disponible. Actualisez puis réessayez.")
            return
        page = DeletePage(self)
        self.delete_page = page
        page.connect("hidden", lambda *_: setattr(self, "delete_page", None))
        self.nav.push(page)
        page.set_data(self.snapper_info)

    def delete_snapshots(self, ids):
        self._begin_busy(f"Suppression de {len(ids)} snapshot(s)…")
        run_helper(["delete"] + list(ids), self._on_delete_done, list(ids))

    def _on_delete_done(self, rc, out, err, ids):
        self._end_busy()
        deleted = []
        for line in out.splitlines():
            if line.startswith("deleted "):
                deleted += [int(x) for x in line.split()[1:] if x.isdigit()]
        for i in deleted:
            self.snapper_info.pop(i, None)
        if self.delete_page is not None:
            self.delete_page.set_data(self.snapper_info)
        if rc == 0:
            n = len(deleted)
            self._toast(f"{n} snapshot supprimé" if n == 1 else f"{n} snapshots supprimés")
        else:
            msg = friendly_error(rc, err, out)
            if deleted:
                msg = f"{len(deleted)} snapshot(s) supprimé(s). {msg}"
            self._error_dialog("Suppression incomplète" if deleted else "Suppression impossible", msg)
        if deleted:
            self._reload_later()

    def _open_cleanup(self):
        if self.running or self.busy:
            return
        page = CleanupPage(self)
        self.cleanup_page = page
        page.connect("hidden", lambda *_: setattr(self, "cleanup_page", None))
        self.nav.push(page)
        page.load()

    # ---- restauration ---------------------------------------------------

    def _on_restore_clicked(self, *_):
        if not self.selected or self.busy or self.running:
            return
        sid, date, desc = self.selected
        dialog = Adw.AlertDialog(
            heading=f"Restaurer le snapshot #{sid} ?",
            body=(f"« {desc or 'sans description'} » du {date}\n\n"
                  "Le système actuel sera sauvegardé puis remplacé par ce snapshot. "
                  "Un redémarrage sera nécessaire. Votre mot de passe administrateur "
                  "peut être demandé."))
        dialog.add_response("cancel", "Annuler")
        dialog.add_response("restore", "Restaurer")
        dialog.set_response_appearance("restore", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda d, r: r == "restore" and self._start_restore())
        dialog.present(self)

    def _start_restore(self):
        self.running = True
        self._interrupted = False
        self.restore_sid = self.selected[0]
        self.backup_desc = self.desc_entry.get_text().strip()
        self._update_selection_ui()

        self.p_status = Adw.StatusPage(title=f"Restauration du snapshot #{self.restore_sid}…",
                                       description="Ne fermez pas cette fenêtre et n'éteignez pas l'ordinateur.")
        spinner = Gtk.Spinner(spinning=True, width_request=48, height_request=48,
                              halign=Gtk.Align.CENTER)
        self.interrupt_btn = Gtk.Button(label="Interrompre", halign=Gtk.Align.CENTER)
        self.interrupt_btn.add_css_class("pill")
        self.interrupt_btn.connect("clicked", lambda *_: self._confirm_interrupt())
        run_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                          halign=Gtk.Align.CENTER)
        run_box.append(spinner)
        run_box.append(self.interrupt_btn)
        self.p_status.set_child(run_box)
        self.p_status.set_vexpand(False)
        self.stage_label = Gtk.Label(label="Préparation", halign=Gtk.Align.CENTER,
                                     margin_bottom=6)
        self.stage_label.add_css_class("heading")
        self.current_stage = "Préparation"
        self._stage_rank = 0

        self.log = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=8, bottom_margin=8,
                                left_margin=8, right_margin=8)
        self.log.add_css_class("card")
        buf = self.log.get_buffer()
        self._tail_mark = buf.create_mark(None, buf.get_end_iter(), True)
        self._shown = 0
        self.log_scroller = Gtk.ScrolledWindow(child=self.log, min_content_height=220, vexpand=True)
        self.expander = Gtk.Expander(label="Détails", child=self.log_scroller, vexpand=True,
                                     margin_start=12, margin_end=12, margin_bottom=12)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self.p_status)
        box.append(self.stage_label)
        box.append(self.expander)

        header = Adw.HeaderBar(show_back_button=False)
        view = Adw.ToolbarView(content=Adw.Clamp(maximum_size=700, child=box))
        view.add_top_bar(header)
        page = Adw.NavigationPage(title="Restauration", tag="progress", child=view,
                                  can_pop=False)
        self.nav.push(page)

        self.runner = RestoreRunner(self._on_update, self._on_prompt, self._on_exit)
        try:
            self.runner.start()
        except (OSError, subprocess.SubprocessError) as e:
            self._finish(False, "Lancement impossible", str(e))

    # Étapes affichées, d'après les messages de l'outil. Une étape ne recule jamais.
    STAGES = (("mounting btrfs", 3, "Montage du volume Btrfs"),
              ("restoring snapshot", 4, "Restauration du snapshot"),
              ("moving child subvolumes", 5, "Déplacement des sous-volumes"),
              ("restoring matching kernel", 6, "Restauration des noyaux"))

    def _set_stage(self, stage, rank=None):
        if rank is not None:
            if rank < self._stage_rank:
                return
            self._stage_rank = rank
        if stage != self.current_stage:
            self.current_stage = stage
            self.stage_label.set_label(stage)

    def _scan_stage(self, lines):
        for line in lines:
            low = line.lower()
            for fragment, rank, label in self.STAGES:
                if fragment in low:
                    self._set_stage(label, rank)

    def _on_update(self):
        if not self._log_flush_id:
            self._log_flush_id = GLib.timeout_add(LOG_FLUSH_MS, self._flush_tick)

    def _flush_tick(self):
        self._log_flush_id = 0
        self._flush_log()
        return False

    def _flush_log(self):
        """Ajoute au journal uniquement les nouvelles lignes (et remplace la ligne en cours)."""
        if self.runner is None:
            return
        if self._log_flush_id:
            GLib.source_remove(self._log_flush_id)
            self._log_flush_id = 0
        term = self.runner.term
        buf = self.log.get_buffer()
        adj = self.log_scroller.get_vadjustment()
        at_bottom = adj.get_value() >= adj.get_upper() - adj.get_page_size() - 40
        buf.delete(buf.get_iter_at_mark(self._tail_mark), buf.get_end_iter())
        new = term.lines[self._shown:]
        if new:
            buf.insert(buf.get_end_iter(), "\n".join(new) + "\n")
            self._shown = len(term.lines)
            self._scan_stage(new)
        buf.move_mark(self._tail_mark, buf.get_end_iter())
        if term.partial:
            buf.insert(buf.get_end_iter(), term.partial)
        if at_bottom:
            GLib.idle_add(self._scroll_log_end)

    def _scroll_log_end(self):
        adj = self.log_scroller.get_vadjustment()
        adj.set_value(adj.get_upper() - adj.get_page_size())
        return False

    def _on_prompt(self, kind, prompt=None):
        sid = self.restore_sid
        if kind == "confirm_current":
            self._set_stage("Préparation", 0)
            self.runner.send("r" if sid == self.booted_id else "l")
        elif kind == "select":
            self._set_stage("Sélection du snapshot", 1)
            self.runner.send(str(sid))
        elif kind == "description":
            self._set_stage("Sauvegarde du système actuel", 2)
            self.runner.send(self.backup_desc)
        elif kind == "reboot":
            # L'interface propose elle-même « Redémarrer maintenant ».
            self._set_stage("Finalisation", 7)
            self.runner.send("n")
        elif kind == "press_enter":
            self._set_stage("Finalisation", 7)
            self.runner.send("")
        elif kind == "unsafe":
            dialog = Adw.AlertDialog(
                heading="Fichiers de démarrage douteux",
                body="Certains fichiers de démarrage de ce snapshot sont absents ou corrompus. "
                     "Le système restauré risque de ne pas démarrer. Voir les détails pour la liste.")
            dialog.add_response("cancel", "Annuler la restauration")
            dialog.add_response("restore", "Restaurer quand même")
            dialog.set_response_appearance("restore", Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.set_default_response("cancel")
            dialog.set_close_response("cancel")
            dialog.connect("response",
                           lambda d, r: self.runner.send("r" if r == "restore" else "c"))
            dialog.present(self)
        elif kind == "unknown":
            entry = Gtk.Entry(placeholder_text="Réponse à envoyer (facultatif)")
            dialog = Adw.AlertDialog(
                heading="Question inattendue",
                body=("limine-snapper-sync attend une réponse que cette version de Snapper "
                      "ne reconnaît pas :\n\n" + (prompt or "") +
                      "\n\nVous pouvez attendre, envoyer une réponse ou interrompre."))
            dialog.set_extra_child(entry)
            dialog.add_response("wait", "Attendre")
            dialog.add_response("send", "Envoyer")
            dialog.add_response("stop", "Interrompre")
            dialog.set_response_appearance("send", Adw.ResponseAppearance.SUGGESTED)
            dialog.set_response_appearance("stop", Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.set_default_response("wait")
            dialog.set_close_response("wait")
            dialog.connect("response", lambda d, r: self._on_unknown_response(r, entry.get_text()))
            dialog.present(self)

    def _on_unknown_response(self, response, text):
        if response == "send" and self.runner is not None:
            self.runner.send(text)
        elif response == "stop":
            self._interrupt()

    def _confirm_interrupt(self):
        if not self.running:
            return
        dialog = Adw.AlertDialog(
            heading="Interrompre la restauration ?",
            body="Interrompre en cours de route peut laisser le système dans un état "
                 "intermédiaire. Consultez le journal avant de redémarrer.")
        dialog.add_response("continue", "Continuer")
        dialog.add_response("stop", "Interrompre")
        dialog.set_response_appearance("stop", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("continue")
        dialog.set_close_response("continue")
        dialog.connect("response", lambda d, r: r == "stop" and self._interrupt())
        dialog.present(self)

    def _interrupt(self):
        if self.runner is None or not self.running:
            return
        self._interrupted = True
        self.interrupt_btn.set_sensitive(False)
        self._set_stage("Interruption…")
        self.runner.cancel()

    def _on_exit(self, rc):
        self._flush_log()
        text = self.runner.term.text()
        low = text.lower()
        if self._interrupted or rc == 130:
            self._finish(False, "Restauration interrompue",
                         "Si l'interruption est survenue en cours de route, consultez le journal "
                         "avant de redémarrer.")
        elif rc == 0 and "Aborted." not in text:
            self._finish(True, f"Snapshot #{self.restore_sid} restauré",
                         "Redémarrez l'ordinateur pour utiliser le système restauré. "
                         "Une entrée de sauvegarde a été ajoutée dans le menu Limine.")
        elif rc == 0:
            self._finish(False, "Restauration annulée", "Aucune modification n'a été effectuée.")
        elif "already running" in low:
            self._finish(False, "Restauration déjà en cours",
                         "Si aucune restauration n'est vraiment en cours, un verrou obsolète "
                         f"subsiste : supprimez le fichier {RESTORE_LOCK} puis réessayez.")
        elif rc in (126, 127) and ("introuvable" in low or "not found" in low):
            self._finish(False, "Outil introuvable",
                         "limine-snapper-sync n'est pas installé ou pas dans le PATH.")
        elif rc in (126, 127):
            self._finish(False, "Authentification refusée",
                         "Les droits administrateur sont nécessaires pour restaurer un snapshot.")
        else:
            self._finish(False, "La restauration a échoué",
                         "Consultez les détails ci-dessous pour en savoir plus.")

    def _finish(self, ok, title, desc):
        self.running = False
        self._update_selection_ui()
        self._set_stage("Terminé" if ok else "Interrompu")
        self.p_status.set_icon_name("object-select-symbolic" if ok else "dialog-error-symbolic")
        self.p_status.set_title(title)
        self.p_status.set_description(desc)

        btns = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
        if ok:
            reboot = Gtk.Button(label="Redémarrer maintenant")
            reboot.add_css_class("suggested-action")
            reboot.add_css_class("pill")
            reboot.connect("clicked", lambda *_: subprocess.Popen(["systemctl", "reboot"]))
            later = Gtk.Button(label="Plus tard")
            later.add_css_class("pill")
            later.connect("clicked", lambda *_: self.close())
            btns.append(later)
            btns.append(reboot)
        else:
            self.expander.set_expanded(True)
            copy_log = Gtk.Button(icon_name="edit-copy-symbolic",
                                  tooltip_text="Copier le journal")
            copy_log.add_css_class("pill")
            copy_log.connect("clicked", self._copy_log)
            back = Gtk.Button(label="Retour")
            back.add_css_class("pill")
            back.connect("clicked", self._back_to_list)
            btns.append(copy_log)
            btns.append(back)
        self.p_status.set_child(btns)

    def _copy_log(self, *_):
        if not self.runner:
            return
        self.get_clipboard().set(self.runner.term.text())
        self._toast("Journal copié")

    # ---- divers ---------------------------------------------------------

    def _toast(self, text):
        toast = Adw.Toast(title=text)
        toast.set_timeout(3)
        self.toast_overlay.add_toast(toast)

    def _error_dialog(self, heading, body):
        dialog = Adw.AlertDialog(heading=heading, body=body)
        dialog.add_response("ok", "Fermer")
        dialog.set_close_response("ok")
        dialog.present(self)

    def _show_shortcuts(self):
        dialog = Adw.AlertDialog(
            heading="Raccourcis clavier",
            body="Ctrl+F — Rechercher\nCtrl+R / F5 — Actualiser\nCtrl+N — Créer un snapshot")
        dialog.add_response("ok", "Fermer")
        dialog.set_close_response("ok")
        dialog.present(self)

    def _show_about(self):
        kwargs = dict(application_name="Snapper", application_icon=APP_ID, version=VERSION,
                      comments="Restaurer, créer et supprimer des snapshots avec Limine et Snapper.",
                      license_type=Gtk.License.GPL_3_0)
        Adw.AboutDialog(**kwargs).present(self)

    def _back_to_list(self, *_):
        self.nav.pop_to_tag("main")
        self.load_snapshots()

    def _on_close_request(self, *_):
        if self.running:
            self._confirm_interrupt()
            return True
        if self.busy:
            self._toast("Une opération est en cours, patientez un instant.")
            return True
        return False


# ======================================================================
#  Page « Supprimer des snapshots »
# ======================================================================

class DeletePage(Adw.NavigationPage):
    def __init__(self, win):
        super().__init__(title="Supprimer des snapshots", tag="delete")
        self.win = win
        self.rows = {}        # id -> (row, check, haystack, protected)
        self.groups = []
        self.info = {}

        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.quick_btn = Gtk.MenuButton(icon_name="edit-select-all-symbolic",
                                        tooltip_text="Sélection rapide")
        menu = Gio.Menu()
        menu.append("Tout sélectionner (visibles)", "del.all")
        menu.append("Plus anciens que 7 jours", "del.7")
        menu.append("Plus anciens que 30 jours", "del.30")
        menu.append("Tout désélectionner", "del.none")
        self.quick_btn.set_menu_model(menu)
        header.pack_end(self.quick_btn)
        view.add_top_bar(header)

        ag = Gio.SimpleActionGroup()
        for name, fn in (("all", lambda *_: self._select(lambda i, d: True)),
                         ("none", lambda *_: self._select(lambda i, d: False)),
                         ("7", lambda *_: self._select_older(7)),
                         ("30", lambda *_: self._select_older(30))):
            a = Gio.SimpleAction.new(name, None)
            a.connect("activate", fn)
            ag.add_action(a)
        self.insert_action_group("del", ag)

        self.search = Gtk.SearchEntry(placeholder_text="Filtrer la liste")
        self.search.connect("search-changed", lambda *_: self._apply_filter())
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                           margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        clamp = Adw.Clamp(maximum_size=800, child=self.box)
        scroll = Gtk.ScrolledWindow(vexpand=True, child=clamp)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        sbox = Gtk.Box(margin_top=6, margin_start=12, margin_end=12)
        self.search.set_hexpand(True)
        sbox.append(self.search)
        top.append(sbox)
        top.append(scroll)
        self.empty = Adw.StatusPage(icon_name="user-trash-symbolic",
                                    title="Aucun snapshot",
                                    description="Il n'y a rien à supprimer.")
        self.stack = Gtk.Stack()
        self.stack.add_named(top, "list")
        self.stack.add_named(self.empty, "empty")
        view.set_content(self.stack)

        bar = Gtk.Box(spacing=12, margin_top=10, margin_bottom=10,
                      margin_start=12, margin_end=12)
        self.count = Gtk.Label(label="Aucun snapshot sélectionné", xalign=0, hexpand=True)
        self.del_btn = Gtk.Button(label="Supprimer")
        self.del_btn.add_css_class("destructive-action")
        self.del_btn.add_css_class("pill")
        self.del_btn.set_sensitive(False)
        self.del_btn.connect("clicked", self._on_delete)
        bar.append(self.count)
        bar.append(self.del_btn)
        view.add_bottom_bar(bar)
        view.set_bottom_bar_style(Adw.ToolbarStyle.RAISED)
        self.set_child(view)

    # ---- données -----------------------------------------------------

    def set_data(self, info):
        keep = {i for i, (_, c, _, _) in self.rows.items() if c.get_active()}
        self.info = dict(info)
        for g in self.groups:
            self.box.remove(g)
        self.groups, self.rows = [], {}
        if not info:
            self.stack.set_visible_child_name("empty")
            self._update_count()
            return
        self.stack.set_visible_child_name("list")
        now = datetime.datetime.now()
        label_prev = None
        group = None
        for sid in sorted(info, reverse=True):
            s = info[sid]
            label = time_bucket(parse_date(s["date"]), now)
            if label != label_prev:
                label_prev = label
                group = Adw.PreferencesGroup(title=label)
                self.box.append(group)
                self.groups.append(group)
            protected = (sid == self.win.booted_id) or s["active"] or s["default"]
            desc = s["desc"] or "(sans description)"
            sub = f"#{sid} · {s['date']}"
            row = Adw.ActionRow(title=GLib.markup_escape_text(desc),
                                subtitle=GLib.markup_escape_text(sub))
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if protected:
                check.set_sensitive(False)
                row.set_tooltip_text("Ce snapshot est en cours d'utilisation : suppression impossible.")
            else:
                check.set_active(sid in keep)
                check.connect("toggled", lambda *_: self._update_count())
                row.set_activatable_widget(check)
            row.add_prefix(check)
            for text, css in self._badges(s, protected):
                lab = Gtk.Label(label=text, valign=Gtk.Align.CENTER)
                lab.add_css_class(css)
                lab.add_css_class("caption-heading")
                row.add_suffix(lab)
            group.add(row)
            hay = f"{sid} {desc} {s['date']} {s['type']} {label}".lower()
            self.rows[sid] = (row, check, hay, protected)
        self._apply_filter()
        self._update_count()

    @staticmethod
    def _badges(s, protected):
        out = []
        if protected:
            out.append(("En cours d'utilisation", "accent"))
        if s["important"]:
            out.append(("Important", "error"))
        b = TYPE_BADGES.get(s["type"])
        if b:
            out.append(b)
        return out

    # ---- filtre et sélection ---------------------------------------------

    def _visible(self, sid):
        q = self.search.get_text().strip().lower()
        return all(w in self.rows[sid][2] for w in q.split()) if q else True

    def _apply_filter(self):
        for sid, (row, _c, _h, _p) in self.rows.items():
            vis = self._visible(sid)
            row.set_visible(vis)
        for g in self.groups:
            g.set_visible(any(r.get_visible() for r in self._group_rows(g)))

    @staticmethod
    def _group_rows(group):
        rows, w = [], group.get_first_child()
        stack = [w] if w else []
        while stack:
            x = stack.pop()
            if isinstance(x, Adw.ActionRow):
                rows.append(x)
            c = x.get_first_child()
            while c:
                stack.append(c)
                c = c.get_next_sibling()
        return rows

    def _select(self, pred):
        for sid, (row, check, _h, protected) in self.rows.items():
            if protected:
                continue
            check.set_active(bool(self._visible(sid) and pred(sid, self.info[sid])))
        self._update_count()

    def _select_older(self, days):
        limit = datetime.datetime.now() - datetime.timedelta(days=days)

        def old(_i, s):
            d = parse_date(s["date"])
            return d is not None and d < limit
        self._select(old)

    def selected_ids(self):
        return sorted(i for i, (_r, c, _h, p) in self.rows.items() if c.get_active() and not p)

    def _update_count(self):
        n = len(self.selected_ids())
        self.count.set_label("Aucun snapshot sélectionné" if n == 0 else
                             "1 snapshot sélectionné" if n == 1 else f"{n} snapshots sélectionnés")
        self.del_btn.set_sensitive(n > 0 and not self.win.busy)

    # ---- suppression -----------------------------------------------------

    def _on_delete(self, *_):
        ids = self.selected_ids()
        if not ids or self.win.busy:
            return
        n = len(ids)
        listing = ", ".join(f"#{i}" for i in ids[:12]) + (" …" if n > 12 else "")
        dialog = Adw.AlertDialog(
            heading="Supprimer 1 snapshot ?" if n == 1 else f"Supprimer {n} snapshots ?",
            body=f"{listing}\n\nCette action est définitive. Les entrées correspondantes "
                 f"disparaîtront aussi du menu Limine.")
        dialog.add_response("cancel", "Annuler")
        dialog.add_response("delete", "Supprimer")
        dialog.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda d, r: r == "delete" and self.win.delete_snapshots(ids))
        dialog.present(self.win)


# ======================================================================
#  Page « Nettoyage automatique »
# ======================================================================

TIMERS = (
    ("snapper-timeline.timer", "Snapshots horaires automatiques",
     "Crée un snapshot chaque heure (timeline)"),
    ("snapper-cleanup.timer", "Nettoyage quotidien",
     "Supprime les anciens snapshots selon les limites ci-dessous"),
    ("snapper-boot.timer", "Snapshot au démarrage",
     "Crée un snapshot à chaque démarrage du système"),
)

# (clé, titre, sous-titre, minimum, maximum)
LIMIT_FIELDS = {
    "number": [
        ("NUMBER_LIMIT", "Snapshots à conserver", "Nombre maximal de snapshots ordinaires"),
        ("NUMBER_LIMIT_IMPORTANT", "Snapshots importants à conserver",
         "Nombre maximal de snapshots marqués importants"),
    ],
    "timeline": [
        ("TIMELINE_LIMIT_HOURLY", "Horaires", "Un par heure"),
        ("TIMELINE_LIMIT_DAILY", "Quotidiens", "Un par jour"),
        ("TIMELINE_LIMIT_WEEKLY", "Hebdomadaires", "Un par semaine"),
        ("TIMELINE_LIMIT_MONTHLY", "Mensuels", "Un par mois"),
        ("TIMELINE_LIMIT_YEARLY", "Annuels", "Un par an"),
    ],
}


def run_plain(argv, callback):
    """Commande sans privilège, asynchrone ; callback(rc, out)."""
    try:
        proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE |
                                  Gio.SubprocessFlags.STDERR_SILENCE)
    except GLib.Error:
        GLib.idle_add(lambda: callback(-1, "") and False)
        return

    def done(p, result):
        try:
            _, out, _e = p.communicate_utf8_finish(result)
        except GLib.Error:
            callback(-1, "")
            return
        callback(p.get_exit_status() if p.get_if_exited() else -1, out or "")
    proc.communicate_utf8_async(None, None, done)


class CleanupPage(Adw.NavigationPage):
    def __init__(self, win):
        super().__init__(title="Nettoyage automatique", tag="cleanup")
        self.win = win
        self.config = {}
        self.widgets = {}      # clé -> (widget, kind)
        self.timer_rows = {}
        self._loading = True

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                           margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        scroll = Gtk.ScrolledWindow(vexpand=True, child=Adw.Clamp(maximum_size=700, child=self.box))
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.spinner = Adw.StatusPage(title="Lecture de la configuration…")
        self.spinner.set_child(Gtk.Spinner(spinning=True, width_request=32, height_request=32))
        self.stack = Gtk.Stack()
        self.stack.add_named(self.spinner, "loading")
        self.stack.add_named(scroll, "form")
        self.error = Adw.StatusPage(icon_name="dialog-error-symbolic", title="Lecture impossible")
        retry = Gtk.Button(label="Réessayer", halign=Gtk.Align.CENTER)
        retry.add_css_class("pill")
        retry.connect("clicked", lambda *_: self.load())
        self.error.set_child(retry)
        self.stack.add_named(self.error, "error")
        view.set_content(self.stack)

        bar = Gtk.Box(spacing=12, margin_top=10, margin_bottom=10, margin_start=12, margin_end=12)
        self.clean_btn = Gtk.Button(label="Nettoyer maintenant")
        self.clean_btn.connect("clicked", self._on_clean)
        spacer = Gtk.Box(hexpand=True)
        self.apply_btn = Gtk.Button(label="Appliquer")
        self.apply_btn.add_css_class("suggested-action")
        self.apply_btn.add_css_class("pill")
        self.apply_btn.set_sensitive(False)
        self.apply_btn.connect("clicked", self._on_apply)
        for w in (self.clean_btn, spacer, self.apply_btn):
            bar.append(w)
        view.add_bottom_bar(bar)
        view.set_bottom_bar_style(Adw.ToolbarStyle.RAISED)
        self.set_child(view)

    # ---- chargement --------------------------------------------------

    def load(self):
        self.stack.set_visible_child_name("loading")
        run_helper(["get-config"], self._on_config)

    def _on_config(self, rc, out, err):
        try:
            data = json.loads(out)
            cfg = {str(k): str(v) for k, v in data["config"].items()}
        except (ValueError, KeyError, TypeError, AttributeError):
            self.error.set_description(GLib.markup_escape_text(friendly_error(rc, err, out)))
            self.stack.set_visible_child_name("error")
            return
        self.config = cfg
        self.cfg_name = data.get("name", "root")
        self._build_form()
        self.stack.set_visible_child_name("form")
        self._refresh_timers()

    def _build_form(self):
        child = self.box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.box.remove(child)
            child = nxt
        self.widgets, self.timer_rows = {}, {}
        self._loading = True

        g = Adw.PreferencesGroup(
            title="Minuteurs système",
            description=f"Configuration Snapper : « {self.cfg_name} ». "
                        f"Ces minuteurs systemd lancent les tâches automatiquement.")
        for unit, title, sub in TIMERS:
            row = Adw.SwitchRow(title=title, subtitle=sub)
            row.connect("notify::active", self._on_timer_toggled, unit)
            g.add(row)
            self.timer_rows[unit] = row
        self.box.append(g)

        self.box.append(self._group(
            "Par nombre (number)",
            "Pour les snapshots avant/après installation (pacman).",
            [("NUMBER_CLEANUP", "Activer", "Supprimer les plus anciens au-delà des limites")] ,
            LIMIT_FIELDS["number"], "NUMBER_MIN_AGE"))
        self.box.append(self._group(
            "Chronologique (timeline)",
            "Garde un nombre limité de snapshots par période.",
            [("TIMELINE_CREATE", "Créer des snapshots horaires",
              "Utilisé par le minuteur horaire"),
             ("TIMELINE_CLEANUP", "Activer le nettoyage", "")],
            LIMIT_FIELDS["timeline"], "TIMELINE_MIN_AGE"))
        self.box.append(self._group(
            "Snapshots vides avant/après", "Supprime les paires qui n'ont aucune différence.",
            [("EMPTY_PRE_POST_CLEANUP", "Activer", "")], [], "EMPTY_PRE_POST_MIN_AGE"))
        self._loading = False
        self._update_dirty()

    def _group(self, title, desc, switches, limits, min_age_key):
        g = Adw.PreferencesGroup(title=title, description=desc)
        for key, t, sub in switches:
            row = Adw.SwitchRow(title=t, subtitle=sub)
            val = self.config.get(key)
            row.set_active(val == "yes")
            row.set_sensitive(val is not None)
            row.connect("notify::active", lambda *_: self._update_dirty())
            g.add(row)
            self.widgets[key] = (row, "bool")
        for key, t, sub in limits:
            self._add_limit(g, key, t, sub)
        self._add_age(g, min_age_key)
        return g

    def _add_limit(self, group, key, title, sub):
        val = self.config.get(key)
        if val is not None and not re.fullmatch(r"[0-9]+", val):
            # intervalle « min-max » : affiché, non modifiable ici
            row = Adw.ActionRow(title=title, subtitle=sub)
            lab = Gtk.Label(label=val, valign=Gtk.Align.CENTER)
            lab.add_css_class("dim-label")
            row.add_suffix(lab)
            group.add(row)
            return
        row = Adw.SpinRow.new_with_range(0, 100000, 1)
        row.set_title(title)
        row.set_subtitle(sub)
        row.set_value(int(val) if val else 0)
        row.set_sensitive(val is not None)
        row.connect("notify::value", lambda *_: self._update_dirty())
        group.add(row)
        self.widgets[key] = (row, "int")

    def _add_age(self, group, key):
        val = self.config.get(key)
        row = Adw.SpinRow.new_with_range(0, 525600, 5)
        row.set_title("Âge minimum (minutes)")
        row.set_subtitle("Un snapshot plus récent n'est jamais supprimé")
        try:
            row.set_value(int(val) // 60)
        except (TypeError, ValueError):
            row.set_sensitive(False)
        row.connect("notify::value", lambda *_: self._update_dirty())
        group.add(row)
        self.widgets[key] = (row, "minutes")

    # ---- minuteurs ----------------------------------------------------

    def _refresh_timers(self):
        for unit in self.timer_rows:
            run_plain(["systemctl", "show", unit, "-p", "UnitFileState"],
                      lambda rc, out, u=unit: self._set_timer_state(u, out))

    def _set_timer_state(self, unit, out):
        row = self.timer_rows.get(unit)
        if row is None:
            return
        state = out.strip().partition("=")[2]
        row.handler_block_by_func(self._on_timer_toggled)
        row.set_active(state in ("enabled", "enabled-runtime", "static"))
        row.set_sensitive(bool(state))
        row.handler_unblock_by_func(self._on_timer_toggled)

    def _on_timer_toggled(self, row, _pspec, unit):
        if self.win.busy:
            return
        on = row.get_active()
        self.win._begin_busy("Modification du minuteur…")
        run_helper(["timers-set", unit, "on" if on else "off"], self._on_timer_done, unit)

    def _on_timer_done(self, rc, out, err, unit):
        self.win._end_busy()
        if rc != 0:
            self.win._error_dialog("Minuteur inchangé", friendly_error(rc, err, out))
        self._refresh_timers()

    # ---- réglages -----------------------------------------------------

    def _current(self, key):
        w, kind = self.widgets[key]
        if kind == "bool":
            return "yes" if w.get_active() else "no"
        if kind == "minutes":
            return str(int(w.get_value()) * 60)
        return str(int(w.get_value()))

    def _changes(self):
        out = []
        for key in self.widgets:
            old = self.config.get(key)
            if old is None:
                continue
            new = self._current(key)
            if kind_is_minutes(self.widgets[key][1]) and old.isdigit() \
                    and int(old) // 60 == int(new) // 60:
                continue
            if new != old:
                out.append(f"{key}={new}")
        return out

    def _update_dirty(self):
        if self._loading:
            return
        self.apply_btn.set_sensitive(bool(self._changes()) and not self.win.busy)

    def _on_apply(self, *_):
        changes = self._changes()
        if not changes or self.win.busy:
            return
        self.win._begin_busy("Enregistrement des réglages…")
        run_helper(["set-config"] + changes, self._on_applied, changes)

    def _on_applied(self, rc, out, err, changes):
        self.win._end_busy()
        if rc == 0:
            for c in changes:
                k, _, v = c.partition("=")
                self.config[k] = v
            self.win._toast("Réglages enregistrés")
        else:
            self.win._error_dialog("Réglages non enregistrés", friendly_error(rc, err, out))
        self._update_dirty()

    def _on_clean(self, *_):
        if self.win.busy:
            return
        dialog = Adw.AlertDialog(
            heading="Nettoyer maintenant ?",
            body="Snapper supprime les snapshots qui dépassent les limites enregistrées "
                 "(number, timeline, paires vides). Si vous avez modifié des réglages, "
                 "appliquez-les d'abord.")
        dialog.add_response("cancel", "Annuler")
        dialog.add_response("go", "Nettoyer")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda d, r: r == "go" and self._run_clean())
        dialog.present(self.win)

    def _run_clean(self):
        self.win._begin_busy("Nettoyage en cours…")
        run_helper(["cleanup", "all"], self._on_cleaned)

    def _on_cleaned(self, rc, out, err):
        self.win._end_busy()
        if rc == 0:
            self.win._toast("Nettoyage terminé")
        else:
            self.win._error_dialog("Nettoyage incomplet", friendly_error(rc, err, out))
        self.win._reload_later(500)


def kind_is_minutes(kind):
    return kind == "minutes"


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.win = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        GLib.set_application_name("Snapper")
        GLib.set_prgname(APP_ID)
        Gtk.Window.set_default_icon_name(APP_ID)

    def do_activate(self):
        new = self.win is None
        if new:
            self.win = MainWindow(self)
        self.win.present()
        if new:
            GLib.idle_add(lambda: self.win.load_snapshots() and False)


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
