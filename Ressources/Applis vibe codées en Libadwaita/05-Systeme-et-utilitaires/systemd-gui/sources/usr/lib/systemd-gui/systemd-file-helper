#!/usr/bin/python3
"""Remove only local entries belonging to one validated systemd service.

This helper is intentionally tiny and has no shell path.  The GUI invokes it
directly; for a system-scope operation pkexec runs this installed, root-owned
copy.  Vendor directories such as /usr/lib/systemd/system are never scanned.
"""

from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path


VALID_SERVICE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9:_.@%\-]*\.service$")


def roots(user: bool) -> tuple[Path, ...]:
    if user:
        return (
            Path.home() / ".config" / "systemd" / "user",
            Path.home() / ".local" / "share" / "systemd" / "user",
        )
    return (Path("/etc/systemd/system"),)


def is_under(path: Path, root: Path) -> bool:
    try:
        return os.path.commonpath(
            [os.path.abspath(os.fspath(path)), os.path.abspath(os.fspath(root))]
        ) == os.path.abspath(os.fspath(root))
    except ValueError:
        return False


def collect(name: str, user: bool) -> list[Path]:
    found: dict[str, Path] = {}
    for root in roots(user):
        if not root.is_dir():
            continue
        drop_in_dir = root / f"{name}.d"
        if os.path.lexists(drop_in_dir):
            found[os.path.abspath(os.fspath(drop_in_dir))] = drop_in_dir

        for current, directories, files in os.walk(
            os.fspath(root), topdown=True, followlinks=False
        ):
            directories[:] = [
                directory
                for directory in directories
                if not os.path.islink(os.path.join(current, directory))
            ]
            current_path = Path(current)
            for directory in directories:
                path = current_path / directory
                if directory == f"{name}.d" or drop_in_dir in path.parents:
                    found[os.path.abspath(os.fspath(path))] = path
            for filename in files:
                path = current_path / filename
                if filename == name or drop_in_dir in path.parents:
                    found[os.path.abspath(os.fspath(path))] = path
    return sorted(found.values(), key=lambda path: (len(path.parts), str(path)), reverse=True)


def remove_entries(name: str, user: bool) -> int:
    removed = 0
    for path in collect(name, user):
        if not any(is_under(path, root) for root in roots(user)):
            print(f"WARN\tChemin ignoré hors de la zone locale : {path}")
            continue
        if not os.path.lexists(path):
            continue
        try:
            if path.is_dir() and not path.is_symlink():
                # Only empty unit-specific drop-in directories are removed.
                path.rmdir()
            else:
                path.unlink()
        except OSError as exc:
            print(f"WARN\tImpossible de supprimer {path} : {exc}")
            continue
        print(f"REMOVED\t{path}")
        removed += 1
    if removed == 0:
        print("NOOP\tAucune entrée locale supprimable trouvée.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    scope = parser.add_mutually_exclusive_group(required=True)
    scope.add_argument("--system", action="store_true")
    scope.add_argument("--user", action="store_true")
    parser.add_argument("unit")
    args = parser.parse_args()
    if not VALID_SERVICE.fullmatch(args.unit):
        parser.error("nom d’unité invalide")
    if args.system and os.geteuid() != 0:
        print("WARN\tLa suppression système doit être exécutée par root.", file=sys.stderr)
        return 1
    return remove_entries(args.unit, user=args.user)


if __name__ == "__main__":
    raise SystemExit(main())
