#!/usr/bin/python3
"""Hôte de messagerie native : relaie à Perceptron ce que l'extension Vivaldi envoie."""

import json
import struct
import subprocess
import sys


def read_message():
    header = sys.stdin.buffer.read(4)
    if len(header) < 4:
        return None
    length = struct.unpack("=I", header)[0]
    return json.loads(sys.stdin.buffer.read(length))


def reply(message):
    data = json.dumps(message).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("=I", len(data)) + data)
    sys.stdout.buffer.flush()


def main():
    message = read_message()
    if not message or not message.get("prompt"):
        reply({"ok": False, "error": "message vide"})
        return
    subprocess.Popen(
        ["/usr/bin/perceptron", "--title", message.get("title", ""), "--prompt", message["prompt"]],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    reply({"ok": True})


if __name__ == "__main__":
    main()
