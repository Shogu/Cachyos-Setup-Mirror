<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Sismographe</vendor>
  <action id="io.github.ogu.Sismographe.inspect">
    <description>Read disk health and filesystem error counters</description>
    <description xml:lang="fr">Lire la santé des disques et les compteurs d’erreurs des systèmes de fichiers</description>
    <message>Authentication is required to read SMART data, btrfs statistics and check the FAT partition (read-only)</message>
    <message xml:lang="fr">Sismographe a besoin de vos droits pour lire SMART, les statistiques btrfs et contrôler la partition FAT (lecture seule, rien n’est modifié)</message>
    <icon_name>io.github.ogu.Sismographe</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/sismographe/sismographe-helper</annotate>
  </action>
</policyconfig>
