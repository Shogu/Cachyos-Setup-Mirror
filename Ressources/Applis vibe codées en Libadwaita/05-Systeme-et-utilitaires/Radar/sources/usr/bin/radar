import threading
import time
import zipfile
from datetime import datetime, timedelta
from xml.etree import ElementTree

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
try:
    gi.require_version("GtkSource", "5")
    from gi.repository import GtkSource
    GtkSource.init()
except (ValueError, ImportError):
    GtkSource = None

from gi.repository import Adw, Gdk, Gio, GLib, GObject, Gtk, Pango

APP_ID = "local.Radar"
ROOT = "/"
MAX_RESULTS = 5000
SHORTLIST = 800  # candidates that get the exact (expensive) fuzzy score per keystroke
INDEX_BATCH = 2000
PREVIEW_LINES = 200
PREVIEW_BYTES = 512 * 1024
HOME = os.path.expanduser("~")

# Mêmes exclusions que la fonction fish d'origine.
PRUNE = ["/proc", "/sys", "/dev", "/run", "/tmp", "/var/tmp", "/var/cache",
         "*/.cache", "*/.cache/*"]
for _d in ("node_modules", ".git", ".venv", "venv", "build", "dist", "target"):
    PRUNE += [f"*/{_d}", f"*/{_d}/*"]


def index_command(show_hidden, roots):
    """List every file under `roots` once (no name filter) — this is the full
    corpus the fuzzy matcher then ranks in memory on every keystroke."""
    cmd = ["find"] + roots + ["("]
    for i, path in enumerate(PRUNE):
        if i:
            cmd.append("-o")
        cmd += ["-path", path]
    command = cmd + [")", "-prune", "-o"]
    if not show_hidden:
        command += ["(", "!", "-path", "*/.*", "-o",
                    "-path", "*/.local/share/Trash/*", ")"]
    return command + ["-type", "f", "-print"]


# ---------- Recherche floue (façon fzf, portée en Python) ----------
#
# Trois étages, du moins cher au plus cher, pour rester réactif même sur un
# index de centaines de milliers de fichiers :
#   1. un masque de bits par nom de fichier rejette en O(1) tout candidat à
#      qui il manque une lettre du motif ;
#   2. une recherche de sous-séquence (gloutonne, la plus à gauche) confirme
#      le candidat et donne une portée (span) bon marché pour un premier tri ;
#   3. seuls les SHORTLIST meilleurs candidats (portée la plus courte) passent
#      par le score exact — une programmation dynamique façon Smith-Waterman
#      qui favorise les lettres consécutives et les débuts de mot/camelCase.
BOUNDARY_CHARS = set("/-_. ")
SCORE_MATCH = 16.0
BONUS_BOUNDARY = 8.0
BONUS_CAMEL = 8.0
BONUS_CONSECUTIVE = 16.0
GAP_PENALTY = 3.0
LEADING_GAP_PENALTY = 1.0
NEG_INF = float("-inf")


def _char_bitmask(text_lower):
    mask = 0
    for ch in text_lower:
        if "a" <= ch <= "z":
            mask |= 1 << (ord(ch) - 97)
        elif "0" <= ch <= "9":
            mask |= 1 << (26 + ord(ch) - 48)
    return mask


def _subsequence_span(hay_lower, pattern_lower):
    """Plus petite fenêtre trouvée par un appariement glouton de gauche à
    droite. None si pattern_lower n'est pas une sous-séquence de hay_lower."""
    pos = 0
    first = -1
    last = -1
    for ch in pattern_lower:
        pos = hay_lower.find(ch, pos)
        if pos == -1:
            return None
        if first == -1:
            first = pos
        last = pos
        pos += 1
    return first, last - first


def _match_bonus(text, i):
    if i == 0:
        return BONUS_BOUNDARY
    prev, cur = text[i - 1], text[i]
    if prev in BOUNDARY_CHARS:
        return BONUS_BOUNDARY
    if prev.islower() and cur.isupper():
        return BONUS_CAMEL
    return 0.0


def fuzzy_score(text, pattern_lower):
    """Score exact (programmation dynamique) d'un appariement flou de
    pattern_lower (déjà en minuscules) dans text. None si ce n'est pas une
    sous-séquence ; sinon un score où plus haut = correspondance plus nette
    (lettres consécutives, début de mot ou de camelCase)."""
    hay = text.casefold()
    n, m = len(hay), len(pattern_lower)
    if m == 0:
        return 0.0
    if m > n:
        return None

    bonus = [_match_bonus(text, j) for j in range(n)]
    prev_row = [NEG_INF] * n

    for i, pch in enumerate(pattern_lower):
        cur_row = [NEG_INF] * n
        running_max = NEG_INF  # max_{k<j} (prev_row[k] + GAP_PENALTY * k)
        for j in range(n):
            if i > 0 and j > 0:
                prior = prev_row[j - 1] + GAP_PENALTY * (j - 1)
                if prior > running_max:
                    running_max = prior
            if hay[j] != pch:
                continue
            if i == 0:
                cur_row[j] = SCORE_MATCH + bonus[j] - LEADING_GAP_PENALTY * j
                continue
            options = []
            if j > 0 and prev_row[j - 1] != NEG_INF:
                options.append(prev_row[j - 1] + BONUS_CONSECUTIVE)
            if running_max != NEG_INF:
                options.append(running_max - GAP_PENALTY * (j - 1))
            if options:
                cur_row[j] = SCORE_MATCH + bonus[j] + max(options)
        prev_row = cur_row

    best = max(prev_row)
    return best if best != NEG_INF else None


EXTENSION_GROUPS = {
    "documents": {
        ".pdf", ".doc", ".docx", ".docm", ".dot", ".dotx",
        ".xls", ".xlsx", ".xlsm", ".xlt", ".xltx", ".xltm",
        ".ppt", ".pptx", ".pptm", ".pps", ".ppsx", ".pot", ".potx",
        ".odt", ".ott", ".ods", ".ots", ".odp", ".otp", ".odg", ".odf",
        ".rtf", ".csv", ".tsv", ".pages", ".numbers", ".key",
    },
    "images": {".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".tiff"},
    "videos": {".mp4", ".mkv", ".webm", ".avi", ".mov", ".ogv"},
    "music": {".mp3", ".flac", ".ogg", ".wav", ".m4a", ".opus"},
    "archives": {
        ".zip", ".zipx", ".rar", ".7z", ".tar", ".tgz", ".tbz", ".txz",
        ".gz", ".bz2", ".xz", ".zst", ".lz", ".lz4", ".lzma", ".lzh",
        ".cab", ".ar", ".cpio", ".deb", ".rpm", ".apk", ".msi", ".jar",
        ".war", ".ear", ".dmg", ".iso", ".img", ".bin", ".cue", ".nrg",
        ".vdi", ".vhd", ".vhdx",
    },
    "code": {".css", ".scss", ".sass", ".less", ".sh", ".bash", ".zsh",
             ".html", ".htm", ".js", ".ts", ".py", ".rs", ".go", ".c",
             ".h", ".cpp", ".java", ".json", ".xml", ".yaml", ".yml",
             ".md", ".markdown", ".mdown", ".mkdn", ".mdwn", ".mdtxt",
             ".mdtext", ".textile", ".rst", ".adoc", ".asciidoc"},
}


def passes_category(name, category):
    if category == "all":
        return True
    extension = os.path.splitext(name)[1].casefold()
    if category == "other":
        return not any(extension in extensions for extensions in EXTENSION_GROUPS.values())
    extensions = EXTENSION_GROUPS.get(category)
    return extensions is not None and extension in extensions


def passes_date(mtime, date_filter):
    if date_filter == "all":
        return True
    now = datetime.now()
    if date_filter == "hour":
        return mtime >= time.time() - 3600
    if date_filter == "today":
        return datetime.fromtimestamp(mtime).date() == now.date()
    if date_filter == "yesterday":
        return datetime.fromtimestamp(mtime).date() == (now - timedelta(days=1)).date()
    if date_filter == "week":
        return mtime >= time.time() - 7 * 86400
    if date_filter == "month":
        return mtime >= time.time() - 30 * 86400
    if date_filter == "older":
        return mtime < time.time() - 30 * 86400
    return True


# ---------- Contenu des archives (bsdtar -tvf, sans rien extraire) ----------
ARCHIVE_SUFFIXES = (
    ".zip", ".zipx", ".7z", ".rar",
    ".tar", ".tar.gz", ".tgz", ".tar.bz2", ".tbz", ".tbz2",
    ".tar.xz", ".txz", ".tar.zst", ".tzst",
    ".tar.lz", ".tar.lz4", ".tar.lzma",
)
ARCHIVE_MAX_ENTRIES = 1000
ARCHIVE_TIMEOUT = 20  # secondes


def _is_archive_name(name):
    return name.casefold().endswith(ARCHIVE_SUFFIXES)


# bsdtar génère lui-même ce format de ligne (mode, liens, propriétaire, groupe,
# taille, date, nom), indépendamment du type d'archive lu : c'est le même
# code de formatage de libarchive pour zip, tar, 7z et rar.
_BSDTAR_LINE_RE = re.compile(
    r"^(?P<mode>\S+)\s+\S+\s+\S+\s+\S+\s+(?P<size>\d+)\s+"
    r"(?P<month>\w{3})\s+(?P<day>\d{1,2})\s+(?P<time_or_year>\S+)\s+(?P<name>.+)$"
)
_MONTHS = {m: i for i, m in enumerate(
    ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"], 1)}


def _bsdtar_mtime(month, day, time_or_year):
    """bsdtar affiche « mois jour heure:minute » pour un fichier récent
    (année sous-entendue = année courante) ou « mois jour année » pour un
    fichier plus ancien — la même ambiguïté que `ls -l`."""
    month_num = _MONTHS.get(month)
    if month_num is None:
        return None
    try:
        day_num = int(day)
        if ":" in time_or_year:
            hour, _, minute = time_or_year.partition(":")
            year = datetime.now().year
            dt = datetime(year, month_num, day_num, int(hour), int(minute))
            if dt > datetime.now() + timedelta(days=1):
                dt = dt.replace(year=year - 1)
        else:
            dt = datetime(int(time_or_year), month_num, day_num)
        return dt.timestamp()
    except ValueError:
        return None


def _parse_bsdtar_line(line):
    """Renvoie (chemin, taille, mtime_ou_None, est_dossier) ou None si la
    ligne ne correspond pas au format habituel de `bsdtar -tv`."""
    match = _BSDTAR_LINE_RE.match(line.rstrip("\n"))
    if match is None:
        return None
    mode = match.group("mode")
    name = match.group("name")
    is_dir = mode.startswith("d") or name.endswith("/")
    mtime = _bsdtar_mtime(match.group("month"), match.group("day"), match.group("time_or_year"))
    return name, int(match.group("size")), mtime, is_dir


def make_spinner(size):
    spinner = Adw.Spinner() if hasattr(Adw, "Spinner") else Gtk.Spinner(spinning=True)
    spinner.set_size_request(size, size)
    return spinner


def office_preview(path):
    """Extract readable DOCX/ODT content without running document payloads."""
    extension = os.path.splitext(path)[1].casefold()
    if extension == ".docx":
        document_name = "word/document.xml"
        namespaces = {
            "w": "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
        }
        paragraph_tag = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}p"
        text_tag = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}t"
        break_tag = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}br"
        table_row_tag = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}tr"
        table_cell_tag = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}tc"
    elif extension == ".odt":
        document_name = "content.xml"
        namespaces = {
            "text": "urn:oasis:names:tc:opendocument:xmlns:text:1.0"
        }
        paragraph_tag = "{urn:oasis:names:tc:opendocument:xmlns:text:1.0}p"
        text_tag = None
        break_tag = "{urn:oasis:names:tc:opendocument:xmlns:text:1.0}line-break"
        table_row_tag = "{urn:oasis:names:tc:opendocument:xmlns:table:1.0}table-row"
        table_cell_tag = "{urn:oasis:names:tc:opendocument:xmlns:table:1.0}table-cell"
    else:
        return None

    with zipfile.ZipFile(path) as archive:
        root = ElementTree.fromstring(archive.read(document_name))

    lines = []
    for element in root.iter():
        if element.tag == paragraph_tag:
            if text_tag is None:
                # ODT : contrairement à DOCX (tout le texte d'un run est dans
                # <w:t>), l'ODF porte le texte sur .text/.tail d'à peu près
                # tous les éléments d'un paragraphe (mise en forme, liens...),
                # donc il faut les récupérer tous, pas seulement .text.
                parts = [element.text or ""]
                for child in element.iter():
                    if child is element:
                        continue
                    parts.append("\n" if child.tag == break_tag else (child.text or ""))
                    parts.append(child.tail or "")
                text = "".join(parts).strip()
            else:
                text = "".join(
                    (child.text or "") if child.tag == text_tag else
                    ("\n" if child.tag == break_tag else "")
                    for child in element.iter()
                ).strip()
            if text:
                lines.append(text)
        elif element.tag == table_row_tag:
            cells = []
            for cell in element.findall(f".//{table_cell_tag}"):
                value = " ".join("".join(cell.itertext()).split())
                if value:
                    cells.append(value)
            if cells:
                lines.append(" | ".join(cells))
    return "\n\n".join(lines)[:PREVIEW_BYTES]


# ---------- Aperçu ODS / XLSX (lecture du XML par zipfile, sans bibliothèque
# externe ; valeurs affichées uniquement, jamais les formules) ----------
PREVIEW_ROWS = 50


def _ods_sheet_rows(table, ns):
    cell_tag = f"{{{ns['table']}}}table-cell"
    covered_tag = f"{{{ns['table']}}}covered-table-cell"
    row_tag = f"{{{ns['table']}}}table-row"
    text_p_tag = f"{{{ns['text']}}}p"
    rep_cols_attr = f"{{{ns['table']}}}number-columns-repeated"
    rows = []
    for row in table.findall(row_tag):
        if len(rows) >= PREVIEW_ROWS:
            break
        cells = []
        for cell in row:
            if cell.tag == cell_tag:
                text = " ".join(
                    "".join(p.itertext()).strip() for p in cell.findall(text_p_tag)
                ).strip()
            elif cell.tag == covered_tag:
                text = ""  # cellule couverte par une fusion : rien à afficher
            else:
                continue
            repeat = int(cell.get(rep_cols_attr, "1"))
            cells.extend([text] * (min(repeat, 200) if text else 1))
        while cells and not cells[-1]:
            cells.pop()
        if cells:
            rows.append(" | ".join(cells))
    return rows


def _ods_preview(path):
    ns = {
        "office": "urn:oasis:names:tc:opendocument:xmlns:office:1.0",
        "table": "urn:oasis:names:tc:opendocument:xmlns:table:1.0",
        "text": "urn:oasis:names:tc:opendocument:xmlns:text:1.0",
    }
    with zipfile.ZipFile(path) as archive:
        root = ElementTree.fromstring(archive.read("content.xml"))
    spreadsheet = root.find(f"{{{ns['office']}}}body/{{{ns['office']}}}spreadsheet")
    if spreadsheet is None:
        return [], 0
    table_tag = f"{{{ns['table']}}}table"
    name_attr = f"{{{ns['table']}}}name"
    tables = spreadsheet.findall(table_tag)
    blocks = []
    for index, table in enumerate(tables, start=1):
        name = table.get(name_attr) or f"Feuille {index}"
        rows = _ods_sheet_rows(table, ns)
        blocks.append(name + "\n" + ("\n".join(rows) if rows else "(feuille vide)"))
    return blocks, len(tables)


def _column_index(cell_ref):
    """« B12 » -> 1 (0-indexé) : numérotation bijective en base 26."""
    index = 0
    for ch in cell_ref:
        if not ch.isalpha():
            break
        index = index * 26 + (ord(ch.upper()) - ord("A") + 1)
    return index - 1


_XLSX_NS = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
_XLSX_REL_NS = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
_XLSX_PKGREL_NS = "http://schemas.openxmlformats.org/package/2006/relationships"


def _xlsx_shared_strings(archive):
    try:
        root = ElementTree.fromstring(archive.read("xl/sharedStrings.xml"))
    except KeyError:
        return []
    strings = []
    for si in root.findall(f"{{{_XLSX_NS}}}si"):
        direct = si.find(f"{{{_XLSX_NS}}}t")
        if direct is not None:
            strings.append(direct.text or "")
        else:
            strings.append("".join(
                run.text or "" for run in si.findall(f"{{{_XLSX_NS}}}r/{{{_XLSX_NS}}}t")))
    return strings


def _xlsx_sheet_targets(archive):
    """Ordre et nom des feuilles (workbook.xml) puis fichier associé à
    chacune (_rels/workbook.xml.rels), plus fiable qu'une simple
    correspondance sheetN.xml <-> N-ième onglet."""
    workbook = ElementTree.fromstring(archive.read("xl/workbook.xml"))
    sheets = workbook.findall(f"{{{_XLSX_NS}}}sheets/{{{_XLSX_NS}}}sheet")
    try:
        rels_root = ElementTree.fromstring(archive.read("xl/_rels/workbook.xml.rels"))
        id_to_target = {
            rel.get("Id"): rel.get("Target")
            for rel in rels_root.findall(f"{{{_XLSX_PKGREL_NS}}}Relationship")
        }
    except KeyError:
        id_to_target = {}
    targets = []
    for position, sheet in enumerate(sheets, start=1):
        name = sheet.get("name") or f"Feuille {position}"
        rid = sheet.get(f"{{{_XLSX_REL_NS}}}id")
        target = id_to_target.get(rid) or f"worksheets/sheet{position}.xml"
        member = target.lstrip("/") if target.startswith("/") else "xl/" + target
        targets.append((name, member))
    return targets


def _xlsx_sheet_rows(archive, member, shared_strings):
    try:
        root = ElementTree.fromstring(archive.read(member))
    except KeyError:
        return ["(feuille introuvable dans le classeur)"]
    rows = []
    for row in root.findall(f"{{{_XLSX_NS}}}sheetData/{{{_XLSX_NS}}}row"):
        if len(rows) >= PREVIEW_ROWS:
            break
        values = {}
        max_col = -1
        next_col = 0
        for cell in row.findall(f"{{{_XLSX_NS}}}c"):
            ref = cell.get("r") or ""
            col = _column_index(ref) if ref else next_col
            next_col = col + 1
            cell_type = cell.get("t", "n")
            value_el = cell.find(f"{{{_XLSX_NS}}}v")
            if cell_type == "inlineStr":
                inline = cell.find(f"{{{_XLSX_NS}}}is")
                text = "".join(inline.itertext()) if inline is not None else ""
            elif value_el is None or value_el.text is None:
                text = ""
            elif cell_type == "s":
                try:
                    text = shared_strings[int(value_el.text)]
                except (ValueError, IndexError):
                    text = ""
            elif cell_type == "b":
                text = "VRAI" if value_el.text == "1" else "FAUX"
            else:
                text = value_el.text  # type "n" (numérique) ou "str"/"e" : valeur, jamais <f>
            if text:
                values[col] = text
                max_col = max(max_col, col)
        cells = [values.get(i, "") for i in range(max_col + 1)]
        while cells and not cells[-1]:
            cells.pop()
        if cells:
            rows.append(" | ".join(cells))
    return rows


def _xlsx_preview(path):
    with zipfile.ZipFile(path) as archive:
        shared_strings = _xlsx_shared_strings(archive)
        targets = _xlsx_sheet_targets(archive)
        blocks = []
        for name, member in targets:
            rows = _xlsx_sheet_rows(archive, member, shared_strings)
            blocks.append(name + "\n" + ("\n".join(rows) if rows else "(feuille vide)"))
    return blocks, len(targets)


def spreadsheet_preview(path):
    """Aperçu texte d'un ODS/XLSX : nom de chaque feuille puis ses premières
    lignes (~PREVIEW_ROWS), cellules séparées par « | », valeurs affichées
    (jamais les formules). Renvoie (texte, nombre_de_feuilles)."""
    extension = os.path.splitext(path)[1].casefold()
    blocks, sheet_count = _ods_preview(path) if extension == ".ods" else _xlsx_preview(path)
    return "\n\n".join(blocks)[:PREVIEW_BYTES], sheet_count


class Result(GObject.Object):
    def __init__(self, path, mtime=None):
        super().__init__()
        self.path = path
        self.name = os.path.basename(path)
        folder = os.path.dirname(path)
        if HOME != "/" and (folder == HOME or folder.startswith(HOME + os.sep)):
            folder = "~" + folder[len(HOME):]
        self.folder = folder
        self.content_type = Gio.content_type_guess(self.name, None)[0]
        if mtime is None:
            try:
                mtime = os.stat(path).st_mtime
            except OSError:
                mtime = 0
        self.mtime = mtime


class ArchiveEntry(GObject.Object):
    def __init__(self, path, size, mtime, is_dir):
        super().__init__()
        self.path = path
        self.size = size
        self.mtime = mtime
        self.is_dir = is_dir


class RadarWindow(Adw.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(title="Radar", default_width=1000, default_height=680, **kwargs)
        self.set_size_request(360, 294)

        self._gen = 0
        self._pattern = ""
        self._category = "all"
        self._path_filter = ""
        self._search_roots = [ROOT]
        self._date_filter = "all"
        self._show_hidden = False
        self._preview_gen = 0
        self._pdf_preview_path = None
        self._truncated = False

        # Index en mémoire : liste de (chemin, nom, nom_cf, masque_de_bits),
        # construite une seule fois par (racine, fichiers cachés), puis
        # reclassée en pur Python à chaque frappe — plus de find par lettre.
        self._index = []
        self._index_gen = 0
        self._index_proc = None
        self._index_ready = False
        self._last_live_refresh = 0.0

        # ---------- Barre latérale : recherche + résultats ----------
        self._store = Gio.ListStore.new(Result)
        self._selection = Gtk.SingleSelection(model=self._store, autoselect=False, can_unselect=True)
        self._selection.connect("selection-changed", self._on_selection_changed)

        factory = Gtk.SignalListItemFactory()
        factory.connect("setup", self._row_setup)
        factory.connect("bind", self._row_bind)
        self._list = Gtk.ListView(model=self._selection, factory=factory, css_classes=["navigation-sidebar"])
        self._list.connect("activate", lambda *_: self._launch(False))

        self._search = Gtk.SearchEntry(placeholder_text="Nom du fichier (facultatif)", hexpand=True, search_delay=400)
        self._search.connect("search-changed", lambda e: self._run_search(e.get_text().strip()))
        self._search.connect("activate", lambda e: self._run_search(e.get_text().strip()))
        self._search.connect("next-match", self._on_next_match)
        self._search.connect("stop-search", lambda e: e.set_text(""))
        self._search.set_key_capture_widget(self)

        start = Adw.StatusPage(icon_name="system-search-symbolic", title="Rechercher un fichier",
                               description="Quelques lettres suffisent, même dans le désordre.",
                               css_classes=["compact"])
        self._empty = Adw.StatusPage(icon_name="system-search-symbolic", title="Aucun résultat",
                                     css_classes=["compact"])
        busy = Adw.StatusPage(title="Recherche en cours…", child=make_spinner(32), css_classes=["compact"])

        self._results_stack = Gtk.Stack()
        self._results_stack.add_named(start, "start")
        self._results_stack.add_named(busy, "busy")
        self._results_stack.add_named(self._empty, "empty")
        self._results_stack.add_named(Gtk.ScrolledWindow(child=self._list), "results")

        menu = Gio.Menu()
        menu.append("À propos de Radar", "app.about")
        menu.append("Quitter", "app.quit")

        self._side_title = Adw.WindowTitle(title="Radar", subtitle="")
        self._busy_spinner = make_spinner(16)
        self._busy_spinner.set_visible(False)
        side_header = Adw.HeaderBar(title_widget=self._side_title)
        side_header.pack_start(self._busy_spinner)
        side_header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", primary=True,
                                            tooltip_text="Menu principal", menu_model=menu))

        self._category_keys = ("all", "documents", "images", "videos", "music", "archives", "code", "other")
        self._category_combo = Gtk.DropDown.new_from_strings(
            ["Tous les types", "Bureautique", "Images", "Vidéos", "Musique", "Archives", "Code", "Autres fichiers"])
        self._category_combo.set_selected(0)
        self._category_combo.connect("notify::selected", self._on_filter_changed)

        self._date_keys = ("all", "hour", "today", "yesterday", "week", "month", "older")
        self._date_combo = Gtk.DropDown.new_from_strings(
            ["Toutes les dates", "Dernière heure", "Aujourd’hui", "Hier", "7 derniers jours", "30 derniers jours", "Plus de 30 jours"])
        self._date_combo.set_selected(0)
        self._date_combo.connect("notify::selected", self._on_filter_changed)

        self._path_combo = Gtk.DropDown()
        self._populate_path_choices()
        self._path_combo.connect("notify::selected", self._on_filter_changed)
        for combo in (self._category_combo, self._date_combo, self._path_combo):
            combo.set_size_request(112, -1)
            combo.set_hexpand(True)

        search_bar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=["toolbar"])
        search_bar.append(self._search)
        filter_row = Gtk.Box(spacing=6)
        filter_row.append(self._category_combo)
        filter_row.append(self._date_combo)
        filter_row.append(self._path_combo)
        search_bar.append(filter_row)

        side_view = Adw.ToolbarView(content=self._results_stack)
        side_view.add_top_bar(side_header)
        side_view.add_top_bar(search_bar)
        side_page = Adw.NavigationPage(title="Radar", child=side_view)

        # ---------- Contenu : aperçu ----------
        self._file_title = Adw.WindowTitle(title="Aperçu", subtitle="")
        content_header = Adw.HeaderBar(title_widget=self._file_title)
        self._open_button = Gtk.Button(label="Ouvrir", action_name="win.open",
                                       css_classes=["suggested-action"],
                                       tooltip_text="Ouvrir avec l’application par défaut (Ctrl+O)")
        content_header.pack_end(self._open_button)
        content_header.pack_end(Gtk.Button(icon_name="folder-open-symbolic", action_name="win.show-folder",
                                           tooltip_text="Afficher dans le dossier (Ctrl+Maj+O)"))
        content_header.pack_end(Gtk.Button(icon_name="edit-copy-symbolic", action_name="win.copy-path",
                                           tooltip_text="Copier le chemin (Ctrl+Maj+C)"))

        if GtkSource:
            self._buffer = GtkSource.Buffer()
            self._text = GtkSource.View(buffer=self._buffer, show_line_numbers=True)
            style = Adw.StyleManager.get_default()
            style.connect("notify::dark", lambda *_: self._update_scheme())
            self._update_scheme()
        else:
            self._buffer = Gtk.TextBuffer()
            self._text = Gtk.TextView(buffer=self._buffer)
        self._text.set_editable(False)
        self._text.set_cursor_visible(False)
        self._text.set_monospace(True)
        self._text.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self._text.set_top_margin(12)
        self._text.set_bottom_margin(12)
        self._text.set_left_margin(12)
        self._text.set_right_margin(12)

