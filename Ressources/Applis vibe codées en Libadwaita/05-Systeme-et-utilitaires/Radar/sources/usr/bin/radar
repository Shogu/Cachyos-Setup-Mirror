        self._search.grab_focus()
        self.connect("close-request", self._on_close_request)
        self._start_indexing()

    def _on_close_request(self, *_args):
        if self._index_proc is not None:
            try:
                self._index_proc.kill()
            except OSError:
                pass
        return False

    # ---------- Liste des résultats ----------
    def _row_setup(self, _factory, item):
        icon = Gtk.Image()
        name = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        folder = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE, css_classes=["dim-label", "caption"])
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True, valign=Gtk.Align.CENTER)
        text.append(name)
        text.append(folder)
        row = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6)
        row.append(icon)
        row.append(text)
        gesture = Gtk.GestureClick(button=3)
        gesture.connect("pressed", self._on_row_context, item)
        row.add_controller(gesture)
        item.set_child(row)

    def _on_row_context(self, gesture, _n_press, x, y, item):
        position = item.get_position()
        if position == Gtk.INVALID_LIST_POSITION:
            return
        self._selection.set_selected(position)
        # x, y sont relatifs à la ligne cliquée, mais le popover est
        # rattaché à toute la liste (self._list) : il faut convertir ces
        # coordonnées dans le repère de la liste, sinon set_pointing_to
        # les prend pour des coordonnées de la liste elle-même et le
        # popover se plante près de son coin haut-gauche.
        row = gesture.get_widget()
        translated = row.translate_coordinates(self._list, x, y)
        list_x, list_y = translated if translated is not None else (x, y)
        # Gdk.Rectangle(x, y, w, h) avec des arguments positionnels est
        # ignoré par cette version de PyGObject (DeprecationWarning, le
        # rectangle reste (0,0,0,0)) : il faut construire l'objet vide puis
        # affecter ses champs un par un.
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = int(list_x), int(list_y), 1, 1
        self._context_popover.set_pointing_to(rect)
        self._context_popover.popup()

    @staticmethod
    def _selected_filter(dropdown, values, default):
        index = dropdown.get_selected()
        return values[index] if 0 <= index < len(values) else default

    def _on_filter_changed(self, *_args):
        self._category = self._selected_filter(self._category_combo, self._category_keys, "all")
        self._date_filter = self._selected_filter(self._date_combo, self._date_keys, "all")
        self._path_filter = ""
        selected_root = self._selected_filter(self._path_combo, self._path_values, ROOT)
        roots_changed = [selected_root] != self._search_roots
        self._search_roots = [selected_root]
        if roots_changed:
            self._start_indexing()
        self._run_search(self._search.get_text().strip(), force=True)

    def _populate_path_choices(self):
        choices = [("all", "Tout le système (/)", ROOT)]
        if os.path.isdir(HOME):
            choices.append(("home", "Dossier personnel", HOME))
        if os.path.isdir("/boot"):
            choices.append(("boot", "/boot", "/boot"))
        candidates = set()
        for parent in ("/run/media", "/media", "/mnt"):
            if os.path.isdir(parent):
                for user_dir in (os.listdir(parent) if parent == "/run/media" else [None]):
                    base = os.path.join(parent, user_dir) if user_dir else parent
                    try:
                        candidates.update(
                            os.path.join(base, name)
                            for name in os.listdir(base)
                            if os.path.isdir(os.path.join(base, name)))
                    except OSError:
                        continue
        for path in sorted(candidates):
            choices.append((path, f"Disque monté · {os.path.basename(path) or path}", path))
        self._path_values = tuple(path for _identifier, _label, path in choices)
        self._path_combo.set_model(Gtk.StringList.new([label for _identifier, label, _path in choices]))
        self._path_combo.set_selected(0)

    def _row_bind(self, _factory, item):
        result = item.get_item()
        row = item.get_child()
        icon = row.get_first_child()
        text = icon.get_next_sibling()
        name = text.get_first_child()
        folder = name.get_next_sibling()
        icon.set_from_gicon(Gio.content_type_get_symbolic_icon(result.content_type))
        name.set_label(result.name)
        folder.set_label(result.folder)
        row.set_tooltip_text(result.path)

    # ---------- Colonnes de la liste d'archive ----------
    def _archive_name_setup(self, _factory, item):
        icon = Gtk.Image()
        label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
        box = Gtk.Box(spacing=6, margin_top=4, margin_bottom=4, margin_start=6)
        box.append(icon)
        box.append(label)
        item.set_child(box)

    def _archive_name_bind(self, _factory, item):
        entry = item.get_item()
        box = item.get_child()
        icon, label = box.get_first_child(), box.get_last_child()
        if entry.is_dir:
            icon.set_from_icon_name("folder-symbolic")
        else:
            content_type = Gio.content_type_guess(os.path.basename(entry.path.rstrip("/")), None)[0]
            icon.set_from_gicon(Gio.content_type_get_symbolic_icon(content_type))
        label.set_label(entry.path)
        label.set_tooltip_text(entry.path)

    def _archive_size_setup(self, _factory, item):
        item.set_child(Gtk.Label(xalign=1, margin_end=6))

    def _archive_size_bind(self, _factory, item):
        entry = item.get_item()
        item.get_child().set_label("" if entry.is_dir else GLib.format_size(entry.size))

    def _archive_date_setup(self, _factory, item):
        item.set_child(Gtk.Label(xalign=0, margin_end=6))

    def _archive_date_bind(self, _factory, item):
        entry = item.get_item()
        label = item.get_child()
        if entry.mtime is None:
            label.set_label("")
        else:
            label.set_label(datetime.fromtimestamp(entry.mtime).strftime("%d/%m/%Y %H:%M"))

    def _on_next_match(self, _entry):
        if self._store.get_n_items() == 0:
            return
        if self._selection.get_selected() == Gtk.INVALID_LIST_POSITION:
            self._selection.set_selected(0)
        self._list.grab_focus()

    def _set_count(self):
        n = self._store.get_n_items()
        if n == 0:
            if not self._index_ready and self._index:
                idx_count = f"{len(self._index):,}".replace(",", " ")
                self._side_title.set_subtitle(f"Indexation en cours... {idx_count} fichiers")
            else:
                self._side_title.set_subtitle("")
            return
        count = f"{n:,}".replace(",", "\u202f") + ("+" if self._truncated else "")
        self._side_title.set_subtitle(f"{count} résultat{'s' if n > 1 else ''}")

    # ---------- Indexation (un find complet, une seule fois) ----------
    def _start_indexing(self):
        self._index_gen += 1
        gen = self._index_gen
        if self._index_proc is not None:
            try:
                self._index_proc.kill()
            except OSError:
                pass
            self._index_proc = None
        self._index = []
        self._index_ready = False
        try:
            proc = subprocess.Popen(
                index_command(self._show_hidden, self._search_roots),
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError as err:
            self._toast(f"Impossible de lancer find : {err.strerror}")
            return
        self._index_proc = proc
        threading.Thread(target=self._index_thread, args=(proc, gen), daemon=True).start()

    def _index_thread(self, proc, gen):
        batch, last = [], time.monotonic()
        for raw in proc.stdout:
            if gen != self._index_gen:
                break
            path = os.fsdecode(raw.rstrip(b"\n"))
            try:
                path.encode()
            except UnicodeEncodeError:
                continue
            name = os.path.basename(path)
            name_cf = name.casefold()
            batch.append((path, name, name_cf, _char_bitmask(name_cf)))
            now = time.monotonic()
            if len(batch) >= INDEX_BATCH or now - last > 0.15:
                GLib.idle_add(self._on_index_batch, gen, batch)
                batch, last = [], now
        if gen != self._index_gen:
            proc.kill()
        proc.wait()
        proc.stdout.close()
        GLib.idle_add(self._on_index_batch, gen, batch)
        GLib.idle_add(self._on_index_done, gen)

    def _on_index_batch(self, gen, batch):
        if gen != self._index_gen:
            return GLib.SOURCE_REMOVE
        if batch:
            self._index.extend(batch)
            self._set_count()
            active = bool(self._pattern or self._path_filter or self._category != "all" or self._date_filter != "all")
            now = time.monotonic()
            if active and now - self._last_live_refresh > 0.4:
                self._last_live_refresh = now
                self._run_search(self._pattern, force=True)
        return GLib.SOURCE_REMOVE

    def _on_index_done(self, gen):
        if gen != self._index_gen:
            return GLib.SOURCE_REMOVE
        self._index_proc = None
        self._index_ready = True
        self._set_count()
        active = bool(self._pattern or self._path_filter or self._category != "all" or self._date_filter != "all")
        if active:
            self._run_search(self._pattern, force=True)
        return GLib.SOURCE_REMOVE

    # ---------- Recherche (classement flou en mémoire) ----------
    def _run_search(self, pattern, force=False):
        if pattern == self._pattern and not force:
            return
        self._pattern = pattern
        self._gen += 1
        gen = self._gen
        self._truncated = False
        self._store.remove_all()
        self._set_count()
        if not pattern and not self._path_filter and self._category == "all" and self._date_filter == "all":
            self._busy_spinner.set_visible(False)
            self._results_stack.set_visible_child_name("start")
            return
        self._busy_spinner.set_visible(True)
        self._results_stack.set_visible_child_name("busy")
        threading.Thread(
            target=self._query_thread,
            args=(gen, pattern, self._category, self._path_filter, self._date_filter, self._index),
            daemon=True,
        ).start()

    def _query_thread(self, gen, pattern, category, path_filter, date_filter, index):
        pattern_lower = pattern.casefold()
        has_pattern = bool(pattern_lower)
        required = _char_bitmask(pattern_lower) if has_pattern else 0
        path_filter_cf = os.path.expanduser(path_filter).casefold() if path_filter else ""

        candidates = []
        for path, name, name_cf, mask in index:
            if gen != self._gen:
                return
            if path_filter_cf and path_filter_cf not in path.casefold():
                continue
            if category != "all" and not passes_category(name, category):
                continue
            if has_pattern:
                if (mask & required) != required:
                    continue
                hit = _subsequence_span(name_cf, pattern_lower)
                if hit is None:
                    continue
                first, span = hit
            else:
                first, span = 0, 0
            candidates.append((span, first, path, name))

        if gen != self._gen:
            return

        candidates.sort(key=lambda t: (t[0], t[1], t[2]))

        if has_pattern:
            scored = []
            for span, first, path, name in candidates[:SHORTLIST]:
                score = fuzzy_score(name, pattern_lower)
                if score is not None:
                    scored.append((-score, len(name), path, name))
            scored.sort()
            ranked = [(path, name) for _s, _l, path, name in scored]
            ranked += [(path, name) for _span, _first, path, name in candidates[SHORTLIST:]]
        else:
            ranked = sorted(((path, name) for _s, _f, path, name in candidates),
                            key=lambda t: t[1].casefold())

        results, considered = [], 0
        for path, name in ranked:
            if gen != self._gen:
                return
            considered += 1
            try:
                mtime = os.stat(path).st_mtime
            except OSError:
                continue  # supprimé/inaccessible depuis l'indexation : on l'ignore
            if not passes_date(mtime, date_filter):
                continue
            results.append((path, mtime))
            if len(results) >= MAX_RESULTS:
                break
        truncated = considered < len(ranked)
        GLib.idle_add(self._on_query_done, gen, results, truncated)

    def _on_query_done(self, gen, results, truncated):
        if gen != self._gen:
            return GLib.SOURCE_REMOVE
        self._truncated = truncated
        if results:
            self._store.splice(0, 0, [Result(path, mtime) for path, mtime in results])
            self._results_stack.set_visible_child_name("results")
        self._busy_spinner.set_visible(False)
        self._set_count()
        if self._store.get_n_items() == 0:
            self._empty.set_description(
                f"Aucun fichier ne correspond à « {GLib.markup_escape_text(self._pattern)} ».")
            self._results_stack.set_visible_child_name("empty")
        return GLib.SOURCE_REMOVE

    # ---------- Aperçu ----------
    def _selected(self):
        return self._selection.get_selected_item()

    def _on_selection_changed(self, _selection, _pos, _n):
        result = self._selected()
        self._preview_gen += 1
        self._cleanup_pdf_preview()
        for action in self._file_actions:
            action.set_enabled(result is not None)
        self._media.set_child(None)
        self._update_open_button(result)
        if result is None:
            self._file_title.set_title("Aperçu")
            self._file_title.set_subtitle("")
            self._show("none", info=None)
            return
        self._file_title.set_title(result.name)
        self._file_title.set_subtitle(result.folder)
        self._show_preview(result)

    def _update_open_button(self, result):
        if result is None:
            self._open_button.set_label("Ouvrir")
            self._open_button.set_tooltip_text("Ouvrir avec l’application par défaut (Ctrl+O)")
            return
        app = Gio.AppInfo.get_default_for_type(result.content_type, False)
        label = f"Ouvrir avec {app.get_display_name()}" if app is not None else "Ouvrir"
        self._open_button.set_label(label)
        self._open_button.set_tooltip_text(f"{label} (Ctrl+O)")

    def _show(self, page, info):
        self._preview.set_visible_child_name(page)
        self._info.set_label(info or "")
        self._content_view.set_reveal_bottom_bars(bool(info))

    def _type_icon_name(self, content_type):
        theme = Gtk.IconTheme.get_for_display(self.get_display())
        for name in Gio.content_type_get_symbolic_icon(content_type).get_names():
            if theme.has_icon(name):
                return name
        return "text-x-generic-symbolic"

    def _show_message(self, icon, title, description, info=None):
        self._message.set_icon_name(icon)
        self._message.set_title(title)
        self._message.set_description(GLib.markup_escape_text(description))
        self._show("message", info)

    def _cleanup_pdf_preview(self):
        if not self._pdf_preview_path:
            return
        try:
            directory = os.path.dirname(self._pdf_preview_path)
            os.unlink(self._pdf_preview_path)
            os.rmdir(directory)
        except OSError:
            pass
        self._pdf_preview_path = None

    def _update_scheme(self):
        dark = Adw.StyleManager.get_default().get_dark()
        scheme = GtkSource.StyleSchemeManager.get_default().get_scheme("Adwaita-dark" if dark else "Adwaita")
        self._buffer.set_style_scheme(scheme)

    def _show_preview(self, result):
        path, content_type = result.path, result.content_type
        try:
            size = os.stat(path).st_size
            details = f"{GLib.format_size(size)} · {Gio.content_type_get_description(content_type)}"
            extension = os.path.splitext(path)[1].casefold()
            if content_type.startswith("image/"):
                picture = Gtk.Picture(file=Gio.File.new_for_path(path), content_fit=Gtk.ContentFit.CONTAIN,
                                      alternative_text=result.name)
                self._media.set_child(picture)
                return self._show("media", details)
            if content_type == "application/pdf":
                self._show_pdf_preview(result.path, details)
                return
            if extension in (".docx", ".odt"):
                try:
                    document_text = office_preview(path)
                except (KeyError, OSError, ValueError, zipfile.BadZipFile,
                        ElementTree.ParseError) as err:
                    return self._show_message(
                        "x-office-document-symbolic",
                        "Aperçu bureautique indisponible",
                        f"Le document ne peut pas être lu : {err}",
                        details,
                    )
                if not document_text:
                    return self._show_message(
                        "x-office-document-symbolic",
                        "Document vide",
                        "Aucun texte ou tableau lisible n’a été trouvé.",
                        details,
                    )
                if GtkSource:
                    self._buffer.set_language(None)
                self._buffer.set_text(document_text)
                self._show("text", details + " · texte et tableaux extraits")
                return
            if extension in (".ods", ".xlsx"):
                try:
                    document_text, sheet_count = spreadsheet_preview(path)
                except (KeyError, OSError, ValueError, zipfile.BadZipFile,
                        ElementTree.ParseError) as err:
                    return self._show_message(
                        "x-office-spreadsheet-symbolic",
                        "Aperçu de tableur indisponible",
                        f"Le classeur ne peut pas être lu : {err}",
                        details,
                    )
                if not document_text:
                    return self._show_message(
                        "x-office-spreadsheet-symbolic",
                        "Classeur vide",
                        "Aucune cellule lisible n’a été trouvée.",
                        details,
                    )
                if GtkSource:
                    self._buffer.set_language(None)
                self._buffer.set_text(document_text)
                sheets_label = f"{sheet_count} feuille{'s' if sheet_count > 1 else ''}"
                self._show("text", f"{details} · {sheets_label} · premières lignes")
                return
            if _is_archive_name(result.name):
                self._show_archive_preview(path, details)
                return
            if content_type.startswith(("video/", "audio/")):
                self._media.set_child(Gtk.Video(file=Gio.File.new_for_path(path), autoplay=False))
                return self._show("media", details)
            if size == 0:
                return self._show_message("text-x-generic-symbolic", "Fichier vide", "", details)
            with open(path, "rb") as handle:
                data = handle.read(PREVIEW_BYTES)
        except OSError as err:
            return self._show_message("dialog-error-symbolic", "Lecture impossible", err.strerror)

        if b"\0" in data[:8192]:
            return self._show_message(self._type_icon_name(content_type), "Aperçu indisponible",
                                      "Utilisez « Ouvrir » pour afficher ce fichier.", details)

        lines = data.decode("utf-8", errors="replace").splitlines()
        truncated = len(lines) > PREVIEW_LINES or size > len(data)
        self._buffer.set_text("\n".join(lines[:PREVIEW_LINES]))
        if GtkSource:
            language = GtkSource.LanguageManager.get_default().guess_language(result.name, content_type)
            self._buffer.set_language(language)
        if truncated:
            details += f" · {PREVIEW_LINES} premières lignes"
        self._show("text", details)

    def _show_pdf_preview(self, path, details):
        self._show_message("application-pdf-symbolic", "Génération de l’aperçu PDF…", "", details)
        generation = self._preview_gen

        def render():
            try:
                directory = tempfile.mkdtemp(prefix="radar-pdf-")
                output = os.path.join(directory, "page")
                subprocess.run(["pdftoppm", "-f", "1", "-singlefile", "-png",
                                "-scale-to", "1600", path, output],
                               check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
                image_path = output + ".png"
            except (OSError, subprocess.CalledProcessError) as err:
                GLib.idle_add(self._show_message, "application-pdf-symbolic",
                              "Aperçu PDF indisponible",
                              "Installez le paquet poppler pour activer l’affichage des PDF.",
                              details)
                return
            GLib.idle_add(self._on_pdf_ready, image_path, details, generation)

        threading.Thread(target=render, daemon=True).start()

    def _on_pdf_ready(self, image_path, details, generation):
        if generation != self._preview_gen:
            try:
                os.unlink(image_path)
                os.rmdir(os.path.dirname(image_path))
            except OSError:
                pass
            return GLib.SOURCE_REMOVE
        self._cleanup_pdf_preview()
        self._pdf_preview_path = image_path
        self._media.set_child(Gtk.Picture.new_for_filename(image_path))
        self._show("media", details + " · première page")
        return GLib.SOURCE_REMOVE

    def _show_archive_preview(self, path, details):
        self._show_message("package-x-generic-symbolic", "Lecture du contenu de l’archive…", "", details)
        generation = self._preview_gen

        def list_archive():
            try:
                proc = subprocess.run(["bsdtar", "-tvf", path], capture_output=True,
                                      text=True, errors="replace", timeout=ARCHIVE_TIMEOUT)
            except OSError as err:
                GLib.idle_add(self._on_archive_error, generation, details, err.strerror)
                return
            except subprocess.TimeoutExpired:
                GLib.idle_add(self._on_archive_error, generation, details,
                              "délai dépassé : archive trop volumineuse ou illisible")
                return
            entries = []
            for line in proc.stdout.splitlines():
                parsed = _parse_bsdtar_line(line)
                if parsed is not None:
                    entries.append(parsed)
            if proc.returncode != 0:
                stderr_lines = [l for l in proc.stderr.strip().splitlines() if l.strip()]
                message = stderr_lines[-1] if stderr_lines else "format d’archive non reconnu"
                GLib.idle_add(self._on_archive_error, generation, details, message)
                return
            truncated = len(entries) > ARCHIVE_MAX_ENTRIES
            if truncated:
                entries = entries[:ARCHIVE_MAX_ENTRIES]
            GLib.idle_add(self._on_archive_ready, generation, entries, truncated, details)

        threading.Thread(target=list_archive, daemon=True).start()

    def _on_archive_error(self, generation, details, message):
        if generation != self._preview_gen:
            return GLib.SOURCE_REMOVE
        self._show_message("package-x-generic-symbolic", "Contenu de l’archive indisponible",
                           f"Archive chiffrée ou illisible ({message}).", details)
        return GLib.SOURCE_REMOVE

    def _on_archive_ready(self, generation, entries, truncated, details):
        if generation != self._preview_gen:
            return GLib.SOURCE_REMOVE
        self._archive_store.remove_all()
        file_count = sum(1 for _path, _size, _mtime, is_dir in entries if not is_dir)
        total_size = sum(size for _path, size, _mtime, is_dir in entries if not is_dir)
        self._archive_store.splice(0, 0, [
            ArchiveEntry(entry_path, size, mtime, is_dir)
            for entry_path, size, mtime, is_dir in entries
        ])
        count_label = f"{file_count} fichier{'s' if file_count > 1 else ''}"
        suffix = " · liste tronquée" if truncated else ""
        self._show("archive", f"{details} · {count_label} · {GLib.format_size(total_size)} décompressés{suffix}")
        return GLib.SOURCE_REMOVE

    # ---------- Actions ----------
    def _toast(self, message):
        self._toasts.add_toast(Adw.Toast.new(GLib.markup_escape_text(message)))

    def _launch(self, containing_folder):
        result = self._selected()
        if result is None:
            return
        launcher = Gtk.FileLauncher.new(Gio.File.new_for_path(result.path))

        def done(source, async_result):
            try:
                if containing_folder:
                    source.open_containing_folder_finish(async_result)
                else:
                    source.launch_finish(async_result)
            except GLib.Error as err:
                if not err.matches(Gtk.dialog_error_quark(), Gtk.DialogError.DISMISSED):
                    self._toast(f"Impossible d’ouvrir le fichier : {err.message}")

        if containing_folder:
            launcher.open_containing_folder(self, None, done)
        else:
            launcher.launch(self, None, done)

    def _copy_path(self, *_):
        result = self._selected()
        if result is not None:
            self.get_clipboard().set(result.path)
            self._toast("Chemin copié")

    def _toggle_hidden(self, *_):
        self._show_hidden = not self._show_hidden
        self._start_indexing()
        self._run_search(self._search.get_text().strip(), force=True)
        self._toast("Fichiers cachés affichés" if self._show_hidden else "Fichiers cachés masqués")

    def _delete_selected(self, *_):
        result = self._selected()
        if result is None:
            return
        dialog = Adw.AlertDialog(
            heading="Supprimer ce fichier ?",
            body=f"« {result.name} » sera supprimé définitivement.",
        )
        dialog.add_response("cancel", "Annuler")
        dialog.add_response("delete", "Supprimer")
        dialog.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.connect("response", self._on_delete_response, result)
        dialog.present(self)

    def _on_delete_response(self, _dialog, response, result):
        if response != "delete":
            return
        try:
            os.remove(result.path)
        except OSError as err:
            self._toast(f"Suppression impossible : {err.strerror}")
            return
        for index in range(self._store.get_n_items()):
            if self._store.get_item(index).path == result.path:
                self._store.remove(index)
                break
        self._index = [entry for entry in self._index if entry[0] != result.path]
        self._set_count()
        self._toast("Fichier supprimé")


class RadarApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self):
        Adw.Application.do_startup(self)
        for name, callback in (("about", self._on_about), ("quit", lambda *_: self.quit())):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", callback)
            self.add_action(action)
        for action, accels in (("app.quit", ["<Ctrl>q"]), ("win.open", ["<Ctrl>o"]),
                               ("win.show-folder", ["<Ctrl><Shift>o"]),
                               ("win.copy-path", ["<Ctrl><Shift>c"]),
                               ("win.focus-search", ["<Ctrl>f"]),
                               ("win.toggle-hidden", ["<Ctrl>h"])):
            self.set_accels_for_action(action, accels)

    def do_activate(self):
        window = self.props.active_window or RadarWindow(application=self)
        window.present()

    def _on_about(self, *_):
        about = Adw.AboutDialog(application_name="Radar", application_icon="radar",
                                version="1.0", comments="Recherche de fichiers avec aperçu.",
                                license_type=Gtk.License.GPL_3_0)
        about.present(self.props.active_window)


if __name__ == "__main__":
    sys.exit(RadarApp().run(sys.argv))
