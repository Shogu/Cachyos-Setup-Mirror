        self._file_actions = []
        for name, callback, needs_file in (
            ("open", lambda *_: self._launch(False), True),
            ("show-folder", lambda *_: self._launch(True), True),
            ("copy-path", self._copy_path, True),
            ("delete", self._delete_selected, True),
            ("focus-search", lambda *_: self._search.grab_focus(), False),
            ("toggle-hidden", self._toggle_hidden, False),
        ):
