#!/usr/bin/env python3
"""Radar — recherche de fichiers avec aperçu (GTK 4 + libadwaita).

Dépendances : python-gobject, gtk4, libadwaita >= 1.5
Optionnel   : gtksourceview5 (coloration syntaxique), gst-plugin-gtk4 (vidéo/audio),
              poppler (pdftoppm pour l’aperçu PDF)
"""

import os
import re
import subprocess
import sys
